---
// FAQ.astro - Emil Kowalski Accordion Motion
const faqItems = [
  {
    q: "How do creators join the ZyoleKai roster?",
    a: "Creators with an active channel and consistent gaming uploads can apply by opening a verification ticket in our Discord (#creator-verification). We review your channel's recent 30-day view retention and content consistency. Once verified, you receive direct access to brand campaign briefs and SMP event invites."
  },
  {
    q: "What types of sponsorships does ZyoleKai coordinate?",
    a: "We manage three core sponsorship formats: (1) YouTube video integrations (60–90s mid-rolls and dedicated sponsored videos), (2) Minecraft SMP event series and tournament sponsorships, and (3) Game server and cloud hosting partnerships with hardware discounts and affiliate terms."
  },
  {
    q: "How do payments and brand contracts work?",
    a: "Every brand campaign operates under clear, agreed-upon deliverables and payout terms established prior to recording. After the video or stream goes live and metrics are verified in #proof-verification, payments are disbursed promptly. ZyoleKai charges creators zero upfront or monthly fees."
  },
  {
    q: "Do creators keep full ownership of their channel and content?",
    a: "Yes. Creators retain 100% ownership of their YouTube channels, twitch streams, content, and IP. We operate on a non-exclusive basis to connect you with commercial opportunities. You have full discretion to accept or decline any sponsorship pitch."
  },
  {
    q: "What are the requirements for Discord server partnerships?",
    a: "We partner with active gaming communities and SMP networks that have at least 250 genuine members and an active moderation team. Partners collaborate on cross-server announcements, community tournaments, and shared creator events."
  },
  {
    q: "How can brands book a campaign or request a custom roster proposal?",
    a: "Brands and publishers can reach our management team directly through our Discord (#executive-desk) or by opening a business inquiry ticket. We provide tailored creator proposals, audience demographics, and view estimates based on your budget."
  }
];
---

<section id="faq" class="section faq-section">
  <div class="container">
    <div class="faq-header">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-subtitle">
        Common questions about representation, brand deals, creator payouts, and server partnerships.
      </p>
    </div>

    <div class="faq-accordion-wrapper">
      {faqItems.map((item, idx) => (
        <div class="faq-card glass-card" data-faq-index={idx}>
          <button class="faq-question-btn" aria-expanded="false">
            <span class="faq-q-text">{item.q}</span>
            <span class="faq-icon-arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 48px;
  }

  .faq-accordion-wrapper {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .faq-card.open {
    border-color: var(--border-brand);
    box-shadow: var(--glow-subtle);
  }

  .faq-question-btn {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-align: left;
    cursor: pointer;
    border-radius: 0;
    color: var(--text-primary);
  }

  .faq-question-btn:active {
    transform: scale(0.99) !important;
  }

  .faq-q-text {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .faq-icon-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .faq-card.open .faq-icon-arrow {
    transform: rotate(180deg);
    background: var(--brand-green);
    color: #061208;
  }

  /* Smooth Zero-JS Grid-Rows Expansion */
  .faq-answer-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-normal) var(--ease-out);
  }

  .faq-card.open .faq-answer-collapse {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .faq-card.open .faq-answer-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .faq-answer-inner p {
    padding: 0 24px 22px 24px;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  @media (max-width: 600px) {
    .faq-question-btn {
      padding: 16px 18px;
    }
    .faq-q-text {
      font-size: 0.98rem;
    }
    .faq-answer-inner p {
      padding: 0 18px 18px 18px;
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon-arrow,
    .faq-answer-collapse,
    .faq-answer-inner {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  const faqCards = document.querySelectorAll('.faq-card');

  faqCards.forEach(card => {
    const btn = card.querySelector('.faq-question-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const isOpen = card.classList.contains('open');

        // Optional: close other cards for accordion behavior
        faqCards.forEach(c => {
          c.classList.remove('open');
          c.querySelector('.faq-question-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          card.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  });
</script>
