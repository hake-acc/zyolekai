---
// FAQ.astro - Emil Kowalski Accordion Motion
const faqItems = [
  {
    q: "How does creator onboarding and verification work?",
    a: "Creators with 500+ subscribers/followers can apply directly by opening a Creator Verification Ticket in our Discord help desk (<#1444635878675972167>). Once verified by our Sponsor Handlers, you unlock private creator lounges, automated upload pings, and priority matching for paying brand and SMP campaigns."
  },
  {
    q: "What types of sponsorships does ZyoleKai offer?",
    a: "We facilitate three primary sponsorship tiers: (1) Brand video integrations with guaranteed CPM and view tiers, (2) Minecraft SMP server collaborations and recording event series, and (3) Enterprise game and bot hosting provisioning with recurring rev-share affiliate payouts."
  },
  {
    q: "How are sponsorship proofs verified and paid out?",
    a: "Creators submit their published video/stream links and 48-hour timestamped YouTube Studio analytics inside our dedicated proof channel (<#1444313503748853915>). Our team validates the deliverables and releases payouts promptly via trusted payment methods."
  },
  {
    q: "What are the requirements to partner with ZyoleKai?",
    a: "Communities must have at least 250+ genuine members, active chat engagement, zero tolerance for toxicity or scams, and full compliance with Discord Terms of Service. In exchange, partners receive spotlight directory listings and shared access to sponsor deals."
  },
  {
    q: "What is the official role structure in ZyoleKai?",
    a: "ZyoleKai operates on a structured hierarchy: Founders & Co-Owners (Executive Vision), Authority (Auditing & Compliance), Leading Soul (Community Transparency), Sponsor Handlers (Deal Execution), Department Managers & Directors (Team Operations), and Verified Creators / Community Members."
  },
  {
    q: "How does ZyoleKai ensure server safety and anti-scam protection?",
    a: "Our Discord server is shielded by hardened 24/7 AutoMod filters, anti-raid mechanisms, and link scanners that instantly block token stealers, fake Nitro phishing links, and unauthorized invite dumps. Rule violators are quarantined automatically."
  },
  {
    q: "How can corporate brands or publishers contact executive leadership?",
    a: "Brands seeking multi-creator campaigns or custom event sponsorships can reach out directly via our executive desk in Discord (<#1444635952747380878>) or email our management team."
  }
];
---

<section id="faq" class="section faq-section">
  <div class="container">
    <div class="faq-header">
      <div class="section-badge">Knowledgebase & FAQs</div>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-subtitle">
        Everything you need to know about joining our creator roster, booking sponsorship campaigns, and navigating our community.
      </p>
    </div>

    <div class="faq-accordion-wrapper">
      {faqItems.map((item, idx) => (
        <div class="faq-card glass-card" data-faq-index={idx}>
          <button class="faq-question-btn" aria-expanded="false">
            <span class="faq-q-text">{item.q}</span>
            <span class="faq-icon-arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 48px;
  }

  .faq-accordion-wrapper {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .faq-card.open {
    border-color: var(--border-brand);
    box-shadow: var(--glow-subtle);
  }

  .faq-question-btn {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-align: left;
    cursor: pointer;
    border-radius: 0;
    color: var(--text-primary);
  }

  .faq-question-btn:active {
    transform: scale(0.99) !important;
  }

  .faq-q-text {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .faq-icon-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .faq-card.open .faq-icon-arrow {
    transform: rotate(180deg);
    background: var(--brand-green);
    color: #061208;
  }

  /* Smooth Zero-JS Grid-Rows Expansion */
  .faq-answer-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-normal) var(--ease-out);
  }

  .faq-card.open .faq-answer-collapse {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
  }

  .faq-answer-inner p {
    padding: 0 24px 22px 24px;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.65;
  }
</style>

<script>
  const faqCards = document.querySelectorAll('.faq-card');

  faqCards.forEach(card => {
    const btn = card.querySelector('.faq-question-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const isOpen = card.classList.contains('open');

        // Optional: close other cards for accordion behavior
        faqCards.forEach(c => {
          c.classList.remove('open');
          c.querySelector('.faq-question-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          card.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  });
</script>
