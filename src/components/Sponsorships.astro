---
import DealCalculator from './DealCalculator.astro';
---

<section id="sponsorships" class="section sponsorships-section">
  <div class="container">
    <!-- Header -->
    <div class="sponsorship-header">
      <h2 class="section-title">Brand Partnerships & Integrations</h2>
      <p class="section-subtitle">
        We manage sponsorships between gaming brands, server hosts, and our creator roster with clear deliverables, fair creator compensation, and verified campaign reporting.
      </p>
    </div>

    <!-- 3 Pillars Cards -->
    <div class="pillars-grid">
      <!-- Pillar 1: Brand Campaigns -->
      <div class="pillar-card glass-card">
        <div class="pillar-icon-box brand-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="4" stroke="url(#emeraldGrad)"></rect>
            <path d="M10 9.5l5 2.5-5 2.5v-5z" fill="url(#emeraldGrad)" stroke="none"></path>
            <path d="M2 8h20" stroke="url(#emeraldGrad)"></path>
          </svg>
        </div>
        <h3 class="pillar-title">YouTube Video Integrations</h3>
        <p class="pillar-desc">
          Dedicated 60–90 second integrations, sponsored segments, and tracked description placements on channels with consistent viewer retention.
        </p>
        <ul class="pillar-features">
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#emeraldGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Verified 30-day average view benchmarks</span>
          </li>
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#emeraldGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Tracked referral links and discount codes</span>
          </li>
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#emeraldGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>End-to-end contract and delivery management</span>
          </li>
        </ul>
        <div class="pillar-footer">
          <span class="pillar-stat">Campaign-Managed</span>
        </div>
      </div>

      <!-- Pillar 2: Minecraft SMP Deals -->
      <div class="pillar-card glass-card">
        <div class="pillar-icon-box smp-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 4l5.5 5.5-11 11H3.5v-5.5L14.5 4z" stroke="url(#emeraldGrad)"></path>
            <path d="M9.5 4L4 9.5l11 11h5.5v-5.5L9.5 4z" stroke="url(#emeraldGrad)"></path>
            <circle cx="12" cy="12" r="2.2" fill="url(#emeraldGrad)" stroke="none"></circle>
          </svg>
        </div>
        <h3 class="pillar-title">Minecraft SMP & Event Series</h3>
        <p class="pillar-desc">
          Sponsored creator SMP seasons, tournament livestreams, and server launches that introduce your brand directly inside active multiplayer gameplay.
        </p>
        <ul class="pillar-features">
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#emeraldGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Coordinated creator recording sessions</span>
          </li>
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#emeraldGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>In-game server branding and custom items</span>
          </li>
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#emeraldGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Cross-promoted streams and whitelist access</span>
          </li>
        </ul>
        <div class="pillar-footer">
          <span class="pillar-stat">Event-Based</span>
        </div>
      </div>

      <!-- Pillar 3: Cloud & Game Server Hosting -->
      <div class="pillar-card glass-card">
        <div class="pillar-icon-box hosting-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="6" rx="2" stroke="url(#emeraldGrad)"></rect>
            <rect x="3" y="14" width="18" height="6" rx="2" stroke="url(#emeraldGrad)"></rect>
            <circle cx="7" cy="7" r="1.2" fill="url(#emeraldGrad)" stroke="none"></circle>
            <circle cx="7" cy="17" r="1.2" fill="url(#emeraldGrad)" stroke="none"></circle>
            <path d="M14 7h3M14 17h3" stroke="url(#emeraldGrad)"></path>
          </svg>
        </div>
        <h3 class="pillar-title">Server Hosting & Infrastructure</h3>
        <p class="pillar-desc">
          Direct partnerships for game server hosts, cloud infrastructure providers, and gaming utilities seeking authentic creator endorsements.
        </p>
        <ul class="pillar-features">
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Creator showcase videos and server tutorials</span>
          </li>
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Exclusive community promo codes</span>
          </li>
          <li>
            <svg class="feature-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Long-term ambassador and affiliate agreements</span>
          </li>
        </ul>
        <div class="pillar-footer">
          <span class="pillar-stat">Ambassadorships</span>
        </div>
      </div>
    </div>

    <!-- Interactive Deal Calculator -->
    <DealCalculator />
  </div>
</section>

<style>
  .sponsorship-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 56px;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .pillar-card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    position: relative;
  }

  .pillar-icon-box {
    width: 58px;
    height: 58px;
    border-radius: var(--radius-md);
    background: rgba(83, 212, 62, 0.1);
    border: 1px solid var(--border-brand);
    color: var(--brand-green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .brand-glow {
    box-shadow: 0 0 20px rgba(83, 212, 62, 0.2);
  }

  .smp-glow {
    color: #FACC15;
    border-color: rgba(250, 204, 21, 0.3);
    background: rgba(250, 204, 21, 0.1);
    box-shadow: 0 0 20px rgba(250, 204, 21, 0.2);
  }

  .hosting-glow {
    color: #06B6D4;
    border-color: rgba(6, 182, 212, 0.3);
    background: rgba(6, 182, 212, 0.1);
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.2);
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .pillar-desc {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .pillar-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.9rem;
    margin-bottom: 28px;
  }

  .pillar-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .feature-check {
    color: var(--brand-green);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pillar-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(13, 28, 18, 0.08);
  }

  .pillar-stat {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #007A3D;
  }

  @media (max-width: 960px) {
    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .pillar-card {
      padding: 24px 18px;
    }
    .pillar-title {
      font-size: 1.2rem;
    }
    .pillar-desc {
      font-size: 0.9rem;
      margin-bottom: 18px;
    }
  }
</style>
