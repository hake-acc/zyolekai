---
// Community.astro - Emil Kowalski Craft Standards
---

<section id="community" class="section community-section">
  <div class="container">
    <!-- Header -->
    <div class="community-header">
      <h2 class="section-title">Discord Community & Partner Network</h2>
      <p class="section-subtitle">
        Our Discord server is the primary hub for creator onboarding, sponsorship discussions, Minecraft SMP announcements, and direct communication with our team.
      </p>
    </div>

    <!-- Main Community Grid -->
    <div class="community-grid">
      <!-- Discord Live Card -->
      <div class="discord-card glass-card">
        <div class="discord-header">
          <img src="/brand/logo.png" alt="ZyoleKai Emblem" class="discord-emblem" />
          <div class="discord-title-box">
            <div class="server-name-row">
              <h3 class="server-name">ZyoleKai Official</h3>
              <span class="partner-badge">Creator Hub</span>
            </div>
            <p class="server-status">
              <span class="online-dot"></span>
              <span>Creator lounges & daily discussions</span>
            </p>
          </div>
        </div>

        <div class="discord-zones-list">
          <div class="zone-item">
            <div class="zone-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </div>
            <div class="zone-info">
              <strong>Start Up & Guidelines</strong>
              <span>Rules, creator roster directory, and verified links</span>
            </div>
          </div>

          <div class="zone-item">
            <div class="zone-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div class="zone-info">
              <strong>Creator Desk & Deals</strong>
              <span>Brand briefs, SMP participation, and proof submissions</span>
            </div>
          </div>

          <div class="zone-item">
            <div class="zone-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div class="zone-info">
              <strong>Community & Gaming Lounges</strong>
              <span>Creator discussions, video feedback, and SMP talk</span>
            </div>
          </div>

          <div class="zone-item">
            <div class="zone-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <div class="zone-info">
              <strong>Support & Verification Tickets</strong>
              <span>Private tickets for creator onboarding and brand inquiries</span>
            </div>
          </div>
        </div>

        <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill" style="width: 100%; margin-top: 20px;">
          <span>Join the Discord Server</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </a>
      </div>

      <!-- Alliance & Partnership Box -->
      <div class="alliance-card glass-card">
        <div class="alliance-header">
          <div class="alliance-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div>
            <h3 class="alliance-title">Server Partnerships</h3>
            <p class="alliance-sub">We collaborate with active gaming communities and SMP servers for cross-promotions and co-hosted events.</p>
          </div>
        </div>

        <div class="alliance-criteria">
          <h4 class="criteria-title">Partnership Criteria</h4>
          <ul class="criteria-list">
            <li>
              <strong>250+ Active Members:</strong>
              <span>Organic community with regular discussion and active moderation.</span>
            </li>
            <li>
              <strong>Clean Standing:</strong>
              <span>Strict compliance with Discord Terms of Service and community safety.</span>
            </li>
            <li>
              <strong>Gaming Focus:</strong>
              <span>Active Minecraft servers, gaming clans, or content creator hubs.</span>
            </li>
          </ul>
        </div>

        <div class="alliance-perks">
          <h4 class="criteria-title">Partner Benefits</h4>
          <div class="perks-tags">
            <span class="perk-tag">Verified Partner Role</span>
            <span class="perk-tag">Partner Directory Listing</span>
            <span class="perk-tag">Joint SMP Events</span>
            <span class="perk-tag">Cross-Announcements</span>
          </div>
        </div>

        <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-pill" style="width: 100%; margin-top: 16px;">
          <span>Apply for Partnership in Discord</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .community-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 56px;
  }

  .community-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .discord-card, .alliance-card {
    padding: 36px;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
  }

  .discord-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(13, 28, 18, 0.08);
    margin-bottom: 24px;
  }

  .discord-emblem {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--brand-green);
    object-fit: cover;
  }

  .discord-title-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .server-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .server-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .partner-badge {
    background: rgba(83, 212, 62, 0.12);
    border: 1px solid var(--border-brand);
    color: var(--brand-green);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .server-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .online-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 8px var(--brand-green);
    animation: radarPulse 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  .discord-zones-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .zone-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: rgba(13, 28, 18, 0.04);
    border: 1px solid rgba(13, 28, 18, 0.08);
    padding: 12px 16px;
    border-radius: var(--radius-md);
  }

  .zone-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(0, 191, 99, 0.1);
    color: var(--brand-green);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .zone-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .zone-info strong {
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .zone-info span {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  /* Alliance Card */
  .alliance-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(13, 28, 18, 0.08);
  }

  .alliance-icon {
    font-size: 2rem;
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.3);
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .alliance-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .alliance-sub {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .criteria-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-green);
    margin-bottom: 12px;
  }

  .criteria-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .criteria-list li {
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--text-secondary);
  }

  .criteria-list li strong {
    color: var(--text-primary);
  }

  .perks-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .perk-tag {
    background: rgba(83, 212, 62, 0.08);
    border: 1px solid rgba(83, 212, 62, 0.2);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-full);
  }

  @media (max-width: 900px) {
    .community-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .discord-card, .alliance-card {
      padding: 22px 18px;
    }
    .discord-header, .alliance-header {
      gap: 12px;
      padding-bottom: 16px;
      margin-bottom: 18px;
    }
  }
</style>
