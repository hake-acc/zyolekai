---
// Hero.astro - Refurnished with Native Motion Graphics, Real Typography & Integrated Banner Waves
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Top Pill -->
    <div class="hero-pill">
      <span class="pill-glow"></span>
      <span class="pill-tag">ZyoleKai Ecosystem</span>
      <span class="pill-sep">•</span>
      <span class="pill-desc">The Premier Gaming & Creator Agency</span>
    </div>

    <!-- Main Headline -->
    <h1 class="hero-headline">
      Where Creators & Brands <br />
      <span class="gradient-text">Scale With Precision.</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle">
      ZyoleKai connects verified gaming YouTubers, Twitch streamers, and influencers with commercial brand sponsorships, Minecraft SMP event series, and high-performance cloud hosting.
    </p>

    <!-- CTAs -->
    <div class="hero-actions">
      <a href="#roster" class="btn btn-primary">
        <span>Explore Talent Roster</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a href="#sponsorships" class="btn btn-secondary">
        <span>Sponsorship Programs</span>
      </a>
    </div>

    <!-- Metrics Bar -->
    <div class="metrics-grid glass-card">
      <div class="metric-item">
        <div class="metric-value">15<span class="metric-plus">+</span></div>
        <div class="metric-label">Verified Creators</div>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <div class="metric-value">6.5M<span class="metric-plus">+</span></div>
        <div class="metric-label">Combined Subscribers</div>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <div class="metric-value">100<span class="metric-plus">%</span></div>
        <div class="metric-label">Verified Payouts</div>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <div class="metric-value">24/7</div>
        <div class="metric-label">Creator Support Desk</div>
      </div>
    </div>

    <!-- Interactive Motion Graphics Showcase (Refurnished from Banner) -->
    <div class="hero-stage-wrapper">
      <div class="hero-stage glass-card" id="heroStage">
        <!-- Precision Chroma-Keyed Organic Waves from Banner -->
        <img src="/brand/corner_wave_tr.png" alt="" class="stage-wave-img wave-tr" aria-hidden="true" />
        <img src="/brand/corner_wave_bl.png" alt="" class="stage-wave-img wave-bl" aria-hidden="true" />
        <img src="/brand/corner_wave_tl.png" alt="" class="stage-wave-img wave-tl" aria-hidden="true" />
        <img src="/brand/corner_wave_br.png" alt="" class="stage-wave-img wave-br" aria-hidden="true" />

        <!-- Subtle Ambient Grid Mesh -->
        <div class="stage-grid-mesh" aria-hidden="true"></div>

        <!-- Centerpiece Content with Exact Transparent Wordmark & Slogan -->
        <div class="stage-centerpiece">
          <div class="stage-emblem-wrap">
            <img src="/brand/logo.png" alt="ZyoleKai 3D Emblem" class="stage-emblem" />
            <div class="stage-emblem-glow"></div>
          </div>

          <div class="stage-brand-wrap">
            <img src="/brand/exact_zyolekai_logo.png" alt="ZyoleKai" class="stage-wordmark" />
            <img src="/brand/exact_slogan.png" alt="Built For Perfection." class="stage-slogan" />
            <p class="stage-kicker">THE PREMIER CREATOR & GAMING NETWORK</p>
            <p class="stage-subline">VERIFIED TALENT ROSTER • BRAND VIDEO INTEGRATIONS • MINECRAFT SMPS</p>
          </div>
        </div>

        <!-- Floating Interactive Motion Graphics Chips -->
        <div class="stage-chip chip-tl float-anim-1">
          <img src="https://yt3.googleusercontent.com/7-JXzXEzN1OoTsCTGN_tkgj2qnMnEs3Kch5zfdA1LO8hZkTrmCHFOU-V-ibYpAZcVVweUlKP=s900-c-k-c0x00ffffff-no-rj" alt="SenpaiSpider" class="chip-avatar" onerror="this.src='/brand/logo.png'" />
          <div class="chip-info">
            <div class="chip-row">
              <span class="chip-title">SenpaiSpider</span>
              <span class="chip-badge">2.69M Subs</span>
            </div>
            <span class="chip-sub">Viral Minecraft Content</span>
          </div>
        </div>

        <div class="stage-chip chip-br float-anim-2">
          <img src="https://yt3.googleusercontent.com/YRiuDwpUPZ_JY7p_rucfwgXqvzaJ3AyU0MvTI0Qmcr5hbPUoK1BHatq4T00Jo2NWLxTQw5TpAA=s900-c-k-c0x00ffffff-no-rj" alt="Mc flame" class="chip-avatar" onerror="this.src='/brand/logo.png'" />
          <div class="chip-info">
            <div class="chip-row">
              <span class="chip-title">Mc flame</span>
              <span class="chip-badge">2.69M Subs</span>
            </div>
            <span class="chip-sub">Storytelling & Roleplay</span>
          </div>
        </div>

        <div class="stage-chip chip-tr float-anim-3">
          <div class="chip-icon-box green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <div class="chip-info">
            <span class="chip-title">100% Payout Escrow</span>
            <span class="chip-sub">Discord V2 Verification</span>
          </div>
        </div>

        <div class="stage-chip chip-bl float-anim-4">
          <div class="chip-icon-box gold">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="chip-info">
            <span class="chip-title">Minecraft SMP Deals</span>
            <span class="chip-sub">Server Whitelist Events</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Organic Wave Transition to Next Section -->
  <div class="hero-wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 90" fill="none" preserveAspectRatio="none">
      <path d="M0,32L60,40C120,48,240,64,360,68C480,72,600,64,720,52C840,40,960,24,1080,24C1200,24,1320,40,1380,48L1440,56L1440,90L1380,90C1320,90,1200,90,1080,90C960,90,840,90,720,90C600,90,480,90,360,90C240,90,120,90,60,90L0,90Z" fill="rgba(14, 19, 31, 0.45)" />
    </svg>
  </div>
</section>

<style>
  .hero-section {
    padding: 160px 0 0 0;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(83, 212, 62, 0.08);
    border: 1px solid var(--border-brand);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    margin-bottom: 28px;
    font-size: 0.88rem;
    backdrop-filter: blur(12px);
    animation: cardFadeUp 200ms var(--ease-out) both;
  }

  .pill-glow {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 12px var(--brand-green);
  }

  .pill-tag {
    font-weight: 700;
    color: var(--brand-green);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  .pill-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .pill-desc {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
    max-width: 960px;
    animation: cardFadeUp 220ms var(--ease-out) 60ms both;
  }

  .gradient-text {
    background: linear-gradient(135deg, #FFFFFF 20%, var(--wave-bright) 60%, var(--brand-green) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 740px;
    line-height: 1.65;
    margin-bottom: 40px;
    animation: cardFadeUp 220ms var(--ease-out) 120ms both;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 56px;
    flex-wrap: wrap;
    animation: cardFadeUp 220ms var(--ease-out) 180ms both;
  }

  .metrics-grid {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    max-width: 920px;
    padding: 24px 32px;
    margin-bottom: 64px;
    border-radius: var(--radius-lg);
    animation: cardFadeUp 240ms var(--ease-out) 240ms both;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .metric-value {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  .metric-plus {
    color: var(--brand-green);
    font-size: 0.85em;
    margin-left: 2px;
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* =========================================================================
     Interactive Motion Graphics Stage (Emil Kowalski Craft)
     ========================================================================= */
  .hero-stage-wrapper {
    width: 100%;
    max-width: 1120px;
    perspective: 1200px;
    margin-bottom: 60px;
  }

  .hero-stage {
    position: relative;
    min-height: 520px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 70px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(14, 19, 31, 0.95) 0%, rgba(7, 9, 14, 0.98) 100%);
    border: 1px solid var(--border-brand);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.7), 0 0 40px rgba(83, 212, 62, 0.15);
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
    will-change: transform;
  }

  /* Real Chroma-Keyed Organic Waves in the Stage */
  .stage-wave-img {
    position: absolute;
    pointer-events: none;
    z-index: 1;
    opacity: 0.35;
    filter: drop-shadow(0 0 24px rgba(83, 212, 62, 0.28));
  }

  .stage-wave-img.wave-tr {
    top: 0;
    right: 0;
    width: 48%;
    max-width: 520px;
  }

  .stage-wave-img.wave-bl {
    bottom: 0;
    left: 0;
    width: 46%;
    max-width: 480px;
  }

  .stage-wave-img.wave-tl {
    top: -10px;
    left: -10px;
    width: 42%;
    max-width: 440px;
    opacity: 0.55;
  }

  .stage-wave-img.wave-br {
    bottom: -10px;
    right: -10px;
    width: 42%;
    max-width: 440px;
    opacity: 0.55;
  }

  .stage-grid-mesh {
    position: absolute;
    inset: 0;
    background-size: 36px 36px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    pointer-events: none;
    z-index: 1;
  }

  /* Centerpiece Typography & Wordmark */
  .stage-centerpiece {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 680px;
    text-align: center;
  }

  .stage-emblem-wrap {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-emblem {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 0 16px rgba(83, 212, 62, 0.5));
    animation: emblemPulse 4s infinite var(--ease-in-out);
  }

  @keyframes emblemPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .stage-emblem-glow {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(83, 212, 62, 0.4) 0%, transparent 70%);
    filter: blur(12px);
    z-index: 1;
  }

  .stage-brand-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .stage-wordmark {
    max-width: 460px;
    width: 88%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 24px rgba(83, 212, 62, 0.4));
  }

  .stage-slogan {
    max-width: 380px;
    width: 76%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 14px rgba(83, 212, 62, 0.3));
    margin-bottom: 6px;
  }

  .stage-kicker {
    font-size: clamp(0.85rem, 1.8vw, 1.05rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--wave-bright);
    text-transform: uppercase;
  }

  .stage-subline {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: 520px;
    line-height: 1.5;
  }

  /* Floating Motion Graphic Chips */
  .stage-chip {
    position: absolute;
    z-index: 6;
    background: rgba(14, 19, 31, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: transform var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    user-select: none;
  }

  .stage-chip:hover {
    border-color: var(--brand-green);
    transform: scale(1.04) !important;
  }

  .chip-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid var(--brand-green);
    object-fit: cover;
  }

  .chip-icon-box {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chip-icon-box.green {
    background: rgba(83, 212, 62, 0.12);
    color: var(--brand-green);
    border: 1px solid rgba(83, 212, 62, 0.3);
  }

  .chip-icon-box.gold {
    background: rgba(250, 204, 21, 0.12);
    color: var(--brand-gold);
    border: 1px solid rgba(250, 204, 21, 0.3);
  }

  .chip-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .chip-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chip-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .chip-badge {
    background: rgba(83, 212, 62, 0.15);
    color: var(--brand-green);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: var(--radius-full);
  }

  .chip-sub {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  /* Chip Positions */
  .chip-tl { top: 32px; left: 36px; }
  .chip-tr { top: 32px; right: 36px; }
  .chip-bl { bottom: 32px; left: 36px; }
  .chip-br { bottom: 32px; right: 36px; }

  /* Subtle Spring Motion Floating Keyframes */
  .float-anim-1 { animation: floatSlow1 4.5s var(--ease-in-out) infinite alternate; }
  .float-anim-2 { animation: floatSlow2 5.0s var(--ease-in-out) infinite alternate; }
  .float-anim-3 { animation: floatSlow2 4.2s var(--ease-in-out) infinite alternate; }
  .float-anim-4 { animation: floatSlow1 4.8s var(--ease-in-out) infinite alternate; }

  @keyframes floatSlow1 {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-7px); }
  }

  @keyframes floatSlow2 {
    0% { transform: translateY(0px); }
    100% { transform: translateY(6px); }
  }

  .hero-wave-divider {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    position: relative;
    z-index: 2;
  }

  .hero-wave-divider svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  /* Responsive Adaptations */
  @media (max-width: 980px) {
    .chip-tl, .chip-tr, .chip-bl, .chip-br {
      display: none;
    }
    .hero-stage {
      min-height: 380px;
      padding: 48px 24px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 100px 0 0 0;
    }

    .hero-pill {
      margin-bottom: 20px;
      font-size: 0.80rem;
      padding: 6px 14px;
      max-width: 90%;
    }

    .hero-pill .pill-desc,
    .hero-pill .pill-sep {
      display: none;
    }

    .hero-headline {
      font-size: clamp(1.55rem, 5.6vw, 2.1rem);
      line-height: 1.15;
      margin-bottom: 16px;
      max-width: 100%;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .hero-subtitle {
      font-size: 0.90rem;
      line-height: 1.55;
      margin-bottom: 24px;
      padding: 0 4px;
      max-width: 100%;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: 12px;
      margin-bottom: 32px;
      padding: 0;
    }

    .hero-actions .btn {
      width: 100%;
      min-height: 48px;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      padding: 16px 12px;
      margin-bottom: 32px;
      width: 100%;
    }

    .metric-value {
      font-size: 1.6rem;
    }

    .metric-label {
      font-size: 0.72rem;
    }

    .metric-divider {
      display: none;
    }

    .hero-stage {
      min-height: 280px;
      padding: 32px 14px;
      width: 100%;
    }

    .stage-wordmark {
      max-width: 210px;
      width: 85%;
    }

    .stage-slogan {
      max-width: 190px;
      width: 78%;
    }

    .stage-kicker {
      font-size: 0.76rem;
      letter-spacing: 0.05em;
    }

    .stage-subline {
      display: none;
    }
  }

  @media (max-width: 440px) {
    .hero-headline {
      font-size: 1.85rem;
    }
    .metrics-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 14px 10px;
    }
    .metric-value {
      font-size: 1.45rem;
    }
    .metric-label {
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-chip, .stage-emblem {
      animation: none !important;
    }
  }
</style>

<script>
  // 3D perspective mouse tracking on hero stage (Emil Kowalski Gated Spring Physics & rAF Throttle)
  const stage = document.getElementById('heroStage');
  if (stage && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let rect = stage.getBoundingClientRect();
    let rafId = 0;

    window.addEventListener('resize', () => {
      rect = stage.getBoundingClientRect();
    });

    stage.addEventListener('pointerenter', () => {
      rect = stage.getBoundingClientRect();
    });

    stage.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        stage.style.transform = `perspective(1000px) rotateX(${y * -7}deg) rotateY(${x * 7}deg)`;
      });
    });

    stage.addEventListener('pointerleave', () => {
      cancelAnimationFrame(rafId);
      stage.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
    });
  }
</script>
