---
// Hero.astro - Refurnished with Native Motion Graphics, Real Typography & Integrated Banner Waves
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Main Headline -->
    <h1 class="hero-headline">
      Creator Management & Brand Deals <br />
      <span class="gradient-text">For Gaming Channels.</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle">
      ZyoleKai represents 15 gaming creators with over 6.5M combined subscribers. We negotiate sponsorship contracts, organize Minecraft SMP events, and manage brand campaigns from brief to delivery.
    </p>

    <!-- CTAs -->
    <div class="hero-actions">
      <a href="#roster" class="btn btn-primary">
        <span>View Creator Roster</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a href="#sponsorships" class="btn btn-secondary">
        <span>Brand Partnerships</span>
      </a>
    </div>

    <!-- Metrics Bar -->
    <div class="metrics-grid glass-card">
      <div class="metric-item">
        <div class="metric-value">15</div>
        <div class="metric-label">Signed Creators</div>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <div class="metric-value">6.5M<span class="metric-plus">+</span></div>
        <div class="metric-label">Total Subscribers</div>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <div class="metric-value">3.5M<span class="metric-plus">+</span></div>
        <div class="metric-label">Top Video Reach</div>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <div class="metric-value">0%</div>
        <div class="metric-label">Creator Upfront Fees</div>
      </div>
    </div>
  </div>

  <!-- Organic Wave Transition to Next Section -->
  <div class="hero-wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 90" fill="none" preserveAspectRatio="none">
      <path d="M0,32L60,40C120,48,240,64,360,68C480,72,600,64,720,52C840,40,960,24,1080,24C1200,24,1320,40,1380,48L1440,56L1440,90L1380,90C1320,90,1200,90,1080,90C960,90,840,90,720,90C600,90,480,90,360,90C240,90,120,90,60,90L0,90Z" fill="rgba(243, 238, 219, 0.7)" />
    </svg>
  </div>
</section>

<style>
  .hero-section {
    padding: 136px 0 0 0;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
    max-width: 960px;
    animation: cardFadeUp 220ms var(--ease-out) both;
  }

  .gradient-text {
    background: linear-gradient(135deg, #0D1C12 0%, #009E52 45%, #00BF63 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 740px;
    line-height: 1.65;
    margin-bottom: 40px;
    animation: cardFadeUp 220ms var(--ease-out) 120ms both;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 56px;
    flex-wrap: wrap;
    animation: cardFadeUp 220ms var(--ease-out) 180ms both;
  }

  .metrics-grid {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    max-width: 920px;
    padding: 24px 32px;
    margin-bottom: 64px;
    border-radius: var(--radius-lg);
    animation: cardFadeUp 240ms var(--ease-out) 240ms both;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  .metric-plus {
    color: var(--brand-green);
    font-size: 0.85em;
    margin-left: 2px;
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-divider {
    width: 1px;
    height: 40px;
    background: rgba(13, 28, 18, 0.1);
  }

  @media (max-width: 900px) {
    .metrics-grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .metric-divider {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .hero-section {
      padding-top: 100px;
    }

    .hero-headline {
      font-size: 2.1rem;
    }

    .hero-subtitle {
      font-size: 0.96rem;
      margin-bottom: 28px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .metrics-grid {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      padding: 16px 12px;
      margin-bottom: 24px;
      width: 100%;
    }

    .metric-value {
      font-size: 1.6rem;
    }

    .metric-label {
      font-size: 0.72rem;
    }

    .metric-divider {
      display: none;
    }
  }

  @media (max-width: 440px) {
    .hero-headline {
      font-size: 1.85rem;
    }
    .metrics-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 14px 10px;
    }
    .metric-value {
      font-size: 1.45rem;
    }
    .metric-label {
      font-size: 0.68rem;
    }
  }

  .hero-wave-divider {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    position: relative;
    z-index: 2;
  }

  .hero-wave-divider svg {
    width: 100%;
    height: 60px;
    display: block;
  }
</style>
