---
import creatorsData from '../data/creators.json';
import brandMatchesData from '../data/brand_matches.json';

const matchesMap = new Map();
brandMatchesData.forEach((m: any) => {
  matchesMap.set(m.creatorId, m);
});

const creators = creatorsData.map((c: any, idx: number) => {
  const match = matchesMap.get(c.id) || {};
  const brandsList = (match.topBrandMatches && match.topBrandMatches.length > 0)
    ? match.topBrandMatches
    : [
        { brand: 'Apex Hosting', compatibilityScore: '98%' },
        { brand: 'BisectHosting', compatibilityScore: '97%' },
        { brand: 'SteelSeries', compatibilityScore: '96%' },
        { brand: 'Shockbyte', compatibilityScore: '95%' },
        { brand: 'Razer', compatibilityScore: '99%' },
        { brand: 'Elgato', compatibilityScore: '98%' }
      ];
  const topMatch = brandsList[idx % brandsList.length] || brandsList[0];

  let calculatedAvg = match.avgViews;
  if (!calculatedAvg && c.recentVideos && c.recentVideos.length > 0) {
    const total = c.recentVideos.reduce((sum: number, v: any) => sum + (v.views || 0), 0);
    calculatedAvg = Math.round(total / c.recentVideos.length).toLocaleString();
  }

  return {
    ...c,
    avgViewsFormatted: calculatedAvg ? `${calculatedAvg}` : '48,500+',
    brandMatch: topMatch.brand || 'Apex Hosting',
    matchScore: topMatch.compatibilityScore || '96%',
    pitchAngle: topMatch.pitchAngle || 'High audience retention and engagement.',
    games: c.games || ['Minecraft', 'SMP', 'Gaming']
  };
});
---

<section id="roster" class="section roster-section">
  <div class="container">
    <!-- Header -->
    <div class="roster-header">
      <h2 class="section-title">Creator Talent Roster</h2>
      <p class="section-subtitle">
        Browse our signed creators across Minecraft storytelling, SMP series, and gaming entertainment. Review verified subscriber counts, recent average views, and individual media kits.
      </p>
    </div>

    <!-- Filter & Search Controls -->
    <div class="roster-controls">
      <div class="filter-pills" id="filterPills">
        <button class="pill-btn active" data-filter="all">All Creators (15)</button>
        <button class="pill-btn" data-filter="smp">Minecraft SMP</button>
        <button class="pill-btn" data-filter="gaming">Gaming & Variety</button>
        <button class="pill-btn" data-filter="high">50k+ Subscribers</button>
      </div>

      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="rosterSearch" placeholder="Search by creator name, game, or niche..." aria-label="Search creators" />
      </div>
    </div>

    <!-- Creators Grid -->
    <div class="creators-grid" id="creatorsGrid">
      {creators.map((c: any, idx: number) => (
        <article
          class="creator-card glass-card animate-fade-up"
          style={`animation-delay: ${Math.min(idx * 40, 600)}ms;`}
          data-name={c.name.toLowerCase()}
          data-niche={c.niche ? c.niche.toLowerCase() : ''}
          data-games={(c.games || []).join(' ').toLowerCase()}
          data-subs={c.subscribers}
          data-creator={JSON.stringify({
            id: c.id,
            name: c.name,
            avatar: c.avatar,
            youtubeUrl: c.youtubeUrl,
            subscribers: c.subscribers,
            avgViews: c.avgViewsFormatted,
            medianViews: c.medianViewsFormatted,
            niche: c.niche,
            videoCount: c.videoCount,
            brandMatch: c.brandMatch,
            matchScore: c.matchScore,
            pitchAngle: c.pitchAngle
          })}
        >
          <div class="card-header">
            <img
              src={c.avatar || c.avatarUrl || `/avatars/${c.slug}.webp`}
              alt={c.name}
              class="creator-avatar"
              width="54"
              height="54"
              loading="lazy"
              onerror="this.src='/brand/logo.webp'"
            />
            <div class="creator-meta">
              <div class="creator-title-row">
                <h3 class="creator-name">{c.name}</h3>
                <svg class="verified-check-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" title="Verified ZyoleKai Creator" aria-label="Verified Creator">
                  <path d="M12 2.2L19.5 5.5v5.8c0 5-3.3 9.4-7.5 10.5-4.2-1.1-7.5-5.5-7.5-10.5V5.5L12 2.2z" fill="url(#emeraldGrad)"></path>
                  <path d="M9 11.8l2.2 2.2 4.3-4.5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <p class="creator-sub-meta">{c.niche || 'Gaming Content Creator'}</p>
            </div>
          </div>

          <div class="card-metrics">
            <div class="c-metric">
              <span class="c-metric-lbl">Subscribers</span>
              <span class="c-metric-val">{c.subscribers}</span>
            </div>
            <div class="c-metric">
              <span class="c-metric-lbl">Avg. Views</span>
              <span class="c-metric-val">{c.avgViewsFormatted}</span>
            </div>
          </div>

          <div class="card-footer">
            <a href={`/roster/${c.slug || c.id}`} class="btn btn-secondary btn-pill" style="flex: 1; text-align: center; justify-content: center;">
              <span>Media Kit →</span>
            </a>
            <a href={c.youtubeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill yt-btn" aria-label={`View ${c.name} on YouTube`}>
              <span>YouTube</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 22c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 2c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .roster-section {
    background: linear-gradient(180deg, rgba(250, 247, 238, 0) 0%, rgba(243, 238, 219, 0.45) 50%, rgba(250, 247, 238, 0) 100%);
  }

  .roster-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 48px;
  }

  .roster-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .filter-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pill-btn {
    background: rgba(255, 255, 255, 0.9);
    border: 1.5px solid rgba(13, 28, 18, 0.12);
    color: var(--text-secondary);
    padding: 8px 18px;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(13, 28, 18, 0.04);
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .pill-btn:hover {
    background: #FFFFFF;
    color: var(--text-primary);
    border-color: var(--brand-green);
  }

  .pill-btn.active {
    background: linear-gradient(115deg, #00BF63 0%, #7ED957 40%, #00BF63 100%);
    background-size: 200% 200%;
    animation: moveButtonGradient 3.5s ease infinite;
    color: #041608;
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 16px rgba(0, 191, 99, 0.35);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid rgba(13, 28, 18, 0.12);
    border-radius: var(--radius-full);
    padding: 8px 18px;
    color: var(--text-muted);
    min-width: 280px;
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 8px rgba(13, 28, 18, 0.04);
  }

  .search-box input {
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    width: 100%;
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  .creators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 24px;
  }

  .creator-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-radius: var(--radius-lg);
    transition: transform var(--duration-fast) var(--ease-spring),
                box-shadow var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .creator-card:hover {
      transform: translateY(-4px);
      border-color: var(--brand-green);
      box-shadow: 0 16px 36px rgba(0, 191, 99, 0.16);
    }
  }

  .creator-card:active {
    transform: scale(0.985);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .creator-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--brand-green);
  }

  .creator-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .creator-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .creator-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .verified-check-svg {
    flex-shrink: 0;
  }

  .creator-sub-meta {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .card-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    background: rgba(13, 28, 18, 0.04);
    border: 1px solid rgba(13, 28, 18, 0.08);
    border-radius: var(--radius-md);
    padding: 12px;
  }

  .c-metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .c-metric-lbl {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 600;
  }

  .c-metric-val {
    font-family: var(--font-display);
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    width: 100%;
  }

  .card-footer .open-kit-btn,
  .card-footer .yt-btn {
    flex: 1 1 0;
    min-width: 0;
    padding: 8px 10px;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .card-footer .open-kit-btn {
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid rgba(13, 28, 18, 0.12);
    color: var(--text-primary);
    box-shadow: 0 2px 6px rgba(13, 28, 18, 0.04);
  }

  .card-footer .open-kit-btn:hover {
    background: #FFFFFF;
    border-color: var(--brand-green);
    color: var(--brand-green);
  }

  .card-footer .yt-btn {
    background: linear-gradient(115deg, #00BF63 0%, #7ED957 40%, #00BF63 100%);
    background-size: 200% 200%;
    animation: moveButtonGradient 3.5s ease infinite;
    color: #041608;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 4px 14px rgba(0, 191, 99, 0.3);
    text-align: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .roster-controls {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .filter-pills {
      overflow-x: auto;
      white-space: nowrap;
      flex-wrap: nowrap;
      padding: 4px 2px 8px 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      width: 100%;
    }

    .filter-pills::-webkit-scrollbar {
      display: none;
    }

    .pill-btn {
      flex-shrink: 0;
      min-height: 40px;
    }

    .search-box {
      width: 100%;
      min-width: unset;
      min-height: 44px;
    }

    .creators-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .creator-card {
      padding: 18px;
    }
  }
</style>

<script>
  // Filter and Search Client Script
  const searchInput = document.getElementById('rosterSearch') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.pill-btn');
  const cards = document.querySelectorAll('.creator-card') as NodeListOf<HTMLElement>;

  let currentFilter = 'all';
  let currentSearch = '';

  function filterCards() {
    cards.forEach(card => {
      const name = card.dataset.name || '';
      const niche = card.dataset.niche || '';
      const games = card.dataset.games || '';
      const subs = card.dataset.subs || '';

      // Match category
      let categoryMatch = true;
      if (currentFilter === 'smp') {
        categoryMatch = games.includes('smp') || games.includes('minecraft') || niche.includes('minecraft');
      } else if (currentFilter === 'gaming') {
        categoryMatch = niche.includes('gaming') || niche.includes('entertainment');
      } else if (currentFilter === 'high') {
        categoryMatch = subs.includes('K') && parseInt(subs) >= 50 || subs.includes('M');
      }

      // Match search
      const textMatch = name.includes(currentSearch) || niche.includes(currentSearch) || games.includes(currentSearch);

      if (categoryMatch && textMatch) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterCards();
    });
  }

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      currentFilter = pill.getAttribute('data-filter') || 'all';
      filterCards();
    });
  });

  // Wire Media Kit Modal Clicks
  cards.forEach(card => {
    const kitBtn = card.querySelector('.open-kit-btn');
    if (kitBtn) {
      kitBtn.addEventListener('click', () => {
        const creatorData = JSON.parse(card.dataset.creator || '{}');
        if ((window as any).openCreatorModal) {
          (window as any).openCreatorModal(creatorData);
        }
      });
    }
  });
</script>
