---
// DealCalculator.astro - Emil Kowalski Interactive Component
---

<div class="calculator-card glass-card">
  <div class="calc-header">
    <h3 class="calc-title">Campaign Scope & Reach Estimator</h3>
    <p class="calc-desc">Estimate projected audience reach, creator placements, and production timelines based on your campaign format.</p>
  </div>

  <div class="calc-grid">
    <!-- Sliders & Inputs -->
    <div class="calc-inputs">
      <div class="input-group">
        <div class="input-header">
          <label>Campaign Format</label>
          <span id="typeBadge" class="val-badge">In-Video Dedicated</span>
        </div>
        <div class="format-picker-grid" role="radiogroup" aria-label="Campaign Format Selection">
          <button type="button" class="format-card-btn active" data-type="integration" data-label="In-Video Dedicated">
            <div class="format-icon-wrap">🎬</div>
            <div class="format-text-wrap">
              <span class="format-card-title">In-Video Dedicated</span>
              <span class="format-card-sub">60–90s Placement</span>
            </div>
          </button>
          
          <button type="button" class="format-card-btn" data-type="smp" data-label="Minecraft SMP">
            <div class="format-icon-wrap">⚔️</div>
            <div class="format-text-wrap">
              <span class="format-card-title">Minecraft SMP</span>
              <span class="format-card-sub">Multi-Creator Series</span>
            </div>
          </button>

          <button type="button" class="format-card-btn" data-type="hosting" data-label="Server Hosting">
            <div class="format-icon-wrap">🌐</div>
            <div class="format-text-wrap">
              <span class="format-card-title">Server Hosting</span>
              <span class="format-card-sub">Infrastructure Deal</span>
            </div>
          </button>

          <button type="button" class="format-card-btn" data-type="stream" data-label="Live Stream">
            <div class="format-icon-wrap">📡</div>
            <div class="format-text-wrap">
              <span class="format-card-title">Live Stream</span>
              <span class="format-card-sub">Broadcast Shoutouts</span>
            </div>
          </button>
        </div>
      </div>

      <div class="input-group">
        <div class="input-header">
          <label for="creatorRange">Target Creator Count</label>
          <span id="creatorCountDisplay" class="val-badge">3 Creators</span>
        </div>
        <input type="range" id="creatorRange" min="1" max="10" value="3" class="calc-slider" aria-label="Target Creator Count" />
      </div>

      <div class="input-group">
        <div class="input-header">
          <label for="viewsRange">Target Audience Views</label>
          <span id="viewsDisplay" class="val-badge">150,000 Views</span>
        </div>
        <input type="range" id="viewsRange" min="20000" max="1000000" step="20000" value="150000" class="calc-slider" aria-label="Target Audience Views" />
      </div>
    </div>

    <!-- Live Output Card -->
    <div class="calc-output">
      <div class="output-box">
        <span class="out-lbl">Projected Campaign Reach</span>
        <span class="out-val" id="impressionsVal">225,000+</span>
        <span class="out-sub">Estimated across dedicated YouTube uploads</span>
      </div>

      <div class="output-details">
        <div class="out-detail-row">
          <span>Campaign Management:</span>
          <strong class="text-green">Dedicated Representative</strong>
        </div>
        <div class="out-detail-row">
          <span>Reporting & Metrics:</span>
          <strong>Verified Studio Analytics</strong>
        </div>
        <div class="out-detail-row">
          <span>Typical Production Window:</span>
          <strong>5–7 Business Days</strong>
        </div>
      </div>

      <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill" style="width: 100%; margin-top: 16px;">
        <span>Discuss Campaign on Discord</span>
      </a>
    </div>
  </div>
</div>

<style>
  .calculator-card {
    padding: 40px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid rgba(0, 191, 99, 0.25);
    margin-top: 48px;
    box-shadow: 0 16px 40px rgba(13, 28, 18, 0.08);
  }

  .calc-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 36px auto;
  }

  .calc-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .calc-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 36px;
    align-items: center;
  }

  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .input-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .val-badge {
    background: rgba(0, 191, 99, 0.12);
    border: 1px solid rgba(0, 191, 99, 0.28);
    color: #008744;
    font-size: 0.8rem;
    padding: 3px 12px;
    border-radius: var(--radius-full);
    font-weight: 700;
  }

  /* Interactive Format Cards Grid (Replaces Black Select Box) */
  .format-picker-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .format-card-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #FFFFFF;
    border: 1.5px solid rgba(13, 28, 18, 0.12);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    transition: all var(--duration-fast) var(--ease-spring);
    position: relative;
    user-select: none;
    font-family: var(--font-sans);
  }

  .format-card-btn:hover {
    border-color: rgba(0, 191, 99, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(13, 28, 18, 0.06);
  }

  .format-card-btn.active {
    background: #FFFFFF;
    border-color: var(--brand-green);
    border-width: 2px;
    box-shadow: 0 4px 16px rgba(0, 191, 99, 0.2);
  }

  .format-card-btn.active::after {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 6px var(--brand-green);
  }

  .format-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(0, 191, 99, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .format-card-btn.active .format-icon-wrap {
    background: rgba(0, 191, 99, 0.16);
  }

  .format-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .format-card-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .format-card-sub {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Sliders with high contrast tracks & tactile thumbs */
  .calc-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    background: rgba(13, 28, 18, 0.12);
    border-radius: var(--radius-full);
    outline: none;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .calc-slider:hover {
    background: rgba(13, 28, 18, 0.18);
  }

  .calc-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand-green);
    border: 3px solid #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 191, 99, 0.4), 0 0 0 1px rgba(13, 28, 18, 0.1);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .calc-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand-green);
    border: 3px solid #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 191, 99, 0.4), 0 0 0 1px rgba(13, 28, 18, 0.1);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  @media (hover: hover) and (pointer: fine) {
    .calc-slider::-webkit-slider-thumb:hover,
    .calc-slider::-moz-range-thumb:hover {
      transform: scale(1.15);
    }
  }

  .calc-slider::-webkit-slider-thumb:active,
  .calc-slider::-moz-range-thumb:active {
    transform: scale(0.95);
  }

  /* Output Card */
  .calc-output {
    background: #FAF7EE;
    border: 1.5px solid rgba(0, 191, 99, 0.25);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 8px 24px rgba(13, 28, 18, 0.04);
  }

  .output-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(13, 28, 18, 0.08);
  }

  .out-lbl {
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .out-val {
    font-family: var(--font-display);
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
    font-size: 2.3rem;
    font-weight: 800;
    color: var(--brand-green);
    line-height: 1.1;
  }

  .out-sub {
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .output-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .out-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .out-detail-row strong {
    color: var(--text-primary);
  }

  .out-detail-row .text-green {
    color: #008744;
  }

  @media (max-width: 900px) {
    .calc-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .calculator-card {
      padding: 24px 16px;
      margin-top: 32px;
    }

    .format-picker-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .calc-output {
      padding: 20px 16px;
    }

    .out-val {
      font-size: 2.0rem;
    }
  }
</style>

<script>
  const formatButtons = document.querySelectorAll('.format-card-btn');
  const typeBadge = document.getElementById('typeBadge');
  const creatorRange = document.getElementById('creatorRange') as HTMLInputElement;
  const creatorCountDisplay = document.getElementById('creatorCountDisplay');
  const viewsRange = document.getElementById('viewsRange') as HTMLInputElement;
  const viewsDisplay = document.getElementById('viewsDisplay');
  const impressionsVal = document.getElementById('impressionsVal');

  let currentMultiplier = 1.35;

  formatButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      formatButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const label = btn.getAttribute('data-label') || 'In-Video Dedicated';
      const type = btn.getAttribute('data-type') || 'integration';
      if (typeBadge) typeBadge.textContent = label;

      if (type === 'integration') currentMultiplier = 1.35;
      else if (type === 'smp') currentMultiplier = 1.65;
      else if (type === 'hosting') currentMultiplier = 1.25;
      else if (type === 'stream') currentMultiplier = 1.45;

      updateEstimates();
    });
  });

  let rAF = 0;
  function updateEstimates() {
    cancelAnimationFrame(rAF);
    rAF = requestAnimationFrame(() => {
      if (!creatorRange || !viewsRange || !impressionsVal) return;

      const creators = parseInt(creatorRange.value);
      const targetViews = parseInt(viewsRange.value);

      if (creatorCountDisplay) {
        creatorCountDisplay.textContent = `${creators} Creator${creators > 1 ? 's' : ''}`;
      }

      if (viewsDisplay) {
        viewsDisplay.textContent = `${targetViews.toLocaleString()} Views`;
      }

      // Multiply views by multiplier based on creator overlap & social impressions
      const totalImpressions = Math.round(targetViews * currentMultiplier * (1 + (creators - 1) * 0.15));
      impressionsVal.textContent = `${totalImpressions.toLocaleString()}+`;
    });
  }

  if (creatorRange) creatorRange.addEventListener('input', updateEstimates);
  if (viewsRange) viewsRange.addEventListener('input', updateEstimates);
</script>
