---
// ZyoleKaiWorkflow.astro - Real-time Motion Graphics Workflow Visualizer
// Replaces static interactive tools with a living, animated SVG node graph
---

<div class="workflow-section glass-card" id="zyolekaiWorkflow">
  <div class="workflow-header">
    <div class="workflow-kicker-row">
      <span class="live-pulse-dot"></span>
      <span class="workflow-kicker-text">Real-Time Agency Pipeline</span>
    </div>
    <h2 class="workflow-title">The ZyoleKai Workflow</h2>
    <p class="workflow-subtitle">
      Watch how our agency guides gaming creators from initial media kit benchmarks to brand outreach, commercial negotiation, and guaranteed sponsorship payout.
    </p>
    
    <!-- Dynamic Stage Tracker Badge -->
    <div class="active-stage-indicator" id="workflowStageBadge">
      <span class="indicator-prefix">Current Phase:</span>
      <strong id="stageLabelText" class="indicator-name">1. Creator Talent Benchmarking</strong>
    </div>
  </div>

  <!-- SVG Motion Graphics Canvas -->
  <div class="workflow-canvas-container">
    <svg
      id="workflowSvg"
      viewBox="0 0 1000 320"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="workflow-svg"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <!-- Emerald Chroma Gradients -->
        <linearGradient id="wfEmeraldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00BF63" />
          <stop offset="100%" stop-color="#007A3D" />
        </linearGradient>

        <linearGradient id="wfActiveGlow" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#00BF63" />
          <stop offset="50%" stop-color="#53D43E" />
          <stop offset="100%" stop-color="#00BF63" />
        </linearGradient>

        <!-- Emerald Glow Filter -->
        <filter id="wfGlow" x="-25%" y="-25%" width="150%" height="150%">
          <feGaussianBlur stdDeviation="3.5" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Faint Background Dotted Guide Path -->
      <path
        id="faintPath"
        d="M 100 135 C 180 75, 220 90, 300 90 C 380 90, 420 175, 500 175 C 580 175, 620 85, 700 85 C 780 85, 820 135, 900 135"
        class="path-base-faint"
      />

      <!-- Active Green Illuminated Path (Reveals dynamically as arrow travels) -->
      <path
        id="illuminatedPath"
        d="M 100 135 C 180 75, 220 90, 300 90 C 380 90, 420 175, 500 175 C 580 175, 620 85, 700 85 C 780 85, 820 135, 900 135"
        class="path-active-illuminated"
      />

      <!-- Fast Rewind Return Arc (For Arrow Quick Reset) -->
      <path
        id="returnPath"
        d="M 900 135 C 750 255, 250 255, 100 135"
        class="path-return-arc"
      />

      <!-- Dynamic Moving Arrow Traveler -->
      <g id="workflowArrow" class="arrow-traveler" transform="translate(100, 135)">
        <circle r="15" fill="rgba(0, 191, 99, 0.22)" class="arrow-beacon-ring" />
        <circle r="7" fill="#00BF63" filter="url(#wfGlow)" />
        <polygon points="13,0 -8,-7 -3,0 -8,7" fill="#041608" stroke="#FFFFFF" stroke-width="1.6" stroke-linejoin="round" />
      </g>

      <!-- CHECKPOINT 1: Signed Creator Talent -->
      <g class="wf-node" id="node1" transform="translate(100, 135)">
        <circle r="36" class="node-bg-circle" />
        <circle r="36" class="node-glow-ring" />
        <!-- Creator Media Kit Icon -->
        <g class="node-icon-group">
          <rect x="-13" y="-13" width="26" height="26" rx="6" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="2" />
          <path d="M-6 -4 L6 -4 M-6 1 L3 1 M-6 6 L0 6" stroke="url(#wfEmeraldGrad)" stroke-width="2" stroke-linecap="round" />
        </g>
        <!-- Milestone Flag Pin: Rises slowly and turns green -->
        <g class="wf-flag-badge" id="flag1">
          <line x1="-5" y1="12" x2="-5" y2="-12" class="flag-pole" />
          <circle cx="-5" cy="-12" r="2.2" class="flag-finial" />
          <g class="flag-banner-group">
            <path d="M -5 -11 L 11 -6 L -5 -1 Z" class="flag-fabric" />
            <path d="M -2 -8.5 L 3 -6 L -2 -3.5" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="flag-chevron" />
          </g>
        </g>
      </g>

      <!-- CHECKPOINT 2: Brand Outreach (High-Precision Megaphone Broadcast) -->
      <g class="wf-node" id="node2" transform="translate(300, 90)">
        <circle r="36" class="node-bg-circle" />
        <circle r="36" class="node-glow-ring" />
        <!-- Outreach Broadcast / Direct Brand Pitch Icon -->
        <g class="node-icon-group">
          <path d="M-10 -3 L-2 -3 L7 -9 L7 9 L-2 3 L-10 3 Z" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="2" stroke-linejoin="round" />
          <path d="M-5 3 L-5 9 L-1 9 L-1 3" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="1.8" stroke-linecap="round" />
          <path d="M10 -5 C13.5 -2.5 13.5 2.5 10 5" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="2" stroke-linecap="round" />
          <path d="M14 -9 C18.5 -4.5 18.5 4.5 14 9" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="1.8" stroke-linecap="round" />
        </g>
        <!-- Milestone Flag Pin: Rises slowly and turns green -->
        <g class="wf-flag-badge" id="flag2">
          <line x1="-5" y1="12" x2="-5" y2="-12" class="flag-pole" />
          <circle cx="-5" cy="-12" r="2.2" class="flag-finial" />
          <g class="flag-banner-group">
            <path d="M -5 -11 L 11 -6 L -5 -1 Z" class="flag-fabric" />
            <path d="M -2 -8.5 L 3 -6 L -2 -3.5" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="flag-chevron" />
          </g>
        </g>
      </g>

      <!-- CHECKPOINT 3: Brand Response & Commercial Terms -->
      <g class="wf-node" id="node3" transform="translate(500, 175)">
        <circle r="36" class="node-bg-circle" />
        <circle r="36" class="node-glow-ring" />
        <!-- Handshake / Alignment Icon -->
        <g class="node-icon-group">
          <path d="M-11 -3 L-4 4 L0 0 L-7 -7 Z" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="1.8" stroke-linejoin="round" />
          <path d="M11 -3 L4 4 L0 0 L7 -7 Z" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="1.8" stroke-linejoin="round" />
          <circle cx="0" cy="8" r="4" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="1.8" />
        </g>
        <!-- Milestone Flag Pin: Rises slowly and turns green -->
        <g class="wf-flag-badge" id="flag3">
          <line x1="-5" y1="12" x2="-5" y2="-12" class="flag-pole" />
          <circle cx="-5" cy="-12" r="2.2" class="flag-finial" />
          <g class="flag-banner-group">
            <path d="M -5 -11 L 11 -6 L -5 -1 Z" class="flag-fabric" />
            <path d="M -2 -8.5 L 3 -6 L -2 -3.5" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="flag-chevron" />
          </g>
        </g>
      </g>

      <!-- CHECKPOINT 4: Content Production & 48h Review -->
      <g class="wf-node" id="node4" transform="translate(700, 85)">
        <circle r="36" class="node-bg-circle" />
        <circle r="36" class="node-glow-ring" />
        <!-- 4K Video Reel / SMP Integration Icon -->
        <g class="node-icon-group">
          <rect x="-12" y="-9" width="24" height="18" rx="4" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="2" />
          <polygon points="-3,-4 5,0 -3,4" fill="url(#wfEmeraldGrad)" />
        </g>
        <!-- Milestone Flag Pin: Rises slowly and turns green -->
        <g class="wf-flag-badge" id="flag4">
          <line x1="-5" y1="12" x2="-5" y2="-12" class="flag-pole" />
          <circle cx="-5" cy="-12" r="2.2" class="flag-finial" />
          <g class="flag-banner-group">
            <path d="M -5 -11 L 11 -6 L -5 -1 Z" class="flag-fabric" />
            <path d="M -2 -8.5 L 3 -6 L -2 -3.5" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="flag-chevron" />
          </g>
        </g>
      </g>

      <!-- CHECKPOINT 5: Sponsorship Delivery & Payout -->
      <g class="wf-node" id="node5" transform="translate(900, 135)">
        <circle r="38" class="node-bg-circle final-node-bg" />
        <circle r="38" class="node-glow-ring final-glow-ring" />
        <!-- Golden Verified Shield & Payout Icon -->
        <g class="node-icon-group">
          <path d="M0 -11 L10 -6 L10 2 C10 8 0 13 0 13 C0 13 -10 8 -10 2 L-10 -6 Z" fill="none" stroke="url(#wfEmeraldGrad)" stroke-width="2" stroke-linejoin="round" />
          <path d="M-3 0 L-1 2 L4 -3" stroke="#00BF63" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <!-- Milestone Flag Pin: Rises slowly and turns green -->
        <g class="wf-flag-badge" id="flag5">
          <line x1="-5" y1="12" x2="-5" y2="-12" class="flag-pole" />
          <circle cx="-5" cy="-12" r="2.2" class="flag-finial" />
          <g class="flag-banner-group">
            <path d="M -5 -11 L 11 -6 L -5 -1 Z" class="flag-fabric" />
            <path d="M -2 -8.5 L 3 -6 L -2 -3.5" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="flag-chevron" />
          </g>
        </g>
      </g>
    </svg>

    <!-- Node Text Labels (Positioned Below/Above Each Node) -->
    <div class="wf-labels-grid">
      <div class="wf-label-card card-node-1" data-stage="1">
        <span class="wf-step-num">STEP 01</span>
        <h4 class="wf-step-title">Signed Creator</h4>
        <p class="wf-step-desc">15 YouTubers verified with analytics benchmarks & media kits ready.</p>
      </div>

      <div class="wf-label-card card-node-2" data-stage="2">
        <span class="wf-step-num">STEP 02</span>
        <h4 class="wf-step-title">Brand Outreach</h4>
        <p class="wf-step-desc">Targeted pitching to game publishers, server hosts, and gaming hardware.</p>
      </div>

      <div class="wf-label-card card-node-3" data-stage="3">
        <span class="wf-step-num">STEP 03</span>
        <h4 class="wf-step-title">Brand Response</h4>
        <p class="wf-step-desc">Brief alignment, CPM negotiation, and 0% upfront fee protection.</p>
      </div>

      <div class="wf-label-card card-node-4" data-stage="4">
        <span class="wf-step-num">STEP 04</span>
        <h4 class="wf-step-title">Production & Review</h4>
        <p class="wf-step-desc">Seamless integration script review with mandatory 48-hour preview draft.</p>
      </div>

      <div class="wf-label-card card-node-5" data-stage="5">
        <span class="wf-step-num">STEP 05</span>
        <h4 class="wf-step-title">Sponsorships Payout</h4>
        <p class="wf-step-desc">Live public upload, tracked conversion metrics, and prompt creator payout.</p>
      </div>
    </div>
  </div>

  <!-- Interactive Workflow Controls -->
  <div class="workflow-controls-bar">
    <button type="button" class="btn btn-secondary btn-pill" id="btnPauseResume">
      <span id="pauseResumeIcon">⏸</span>
      <span id="pauseResumeText">Pause Motion</span>
    </button>

    <div class="workflow-progress-track">
      <div class="workflow-progress-fill" id="workflowProgressFill"></div>
    </div>

    <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill">
      <span>Initiate Campaign ↗</span>
    </a>
  </div>
</div>

<script>
  // ZyoleKai Workflow Engine: 60fps Precision SVG Vector Animator
  function initZyoleKaiWorkflow() {
    const section = document.getElementById('zyolekaiWorkflow');
    if (!section) return;

    const faintPath = document.getElementById('faintPath') as SVGPathElement | null;
    const illuminatedPath = document.getElementById('illuminatedPath') as SVGPathElement | null;
    const returnPath = document.getElementById('returnPath') as SVGPathElement | null;
    const arrow = document.getElementById('workflowArrow');
    const stageBadge = document.getElementById('stageLabelText');
    const progressFill = document.getElementById('workflowProgressFill');
    const btnPause = document.getElementById('btnPauseResume');
    const pauseIcon = document.getElementById('pauseResumeIcon');
    const pauseText = document.getElementById('pauseResumeText');

    if (!faintPath || !illuminatedPath || !returnPath || !arrow) return;

    const forwardLength = faintPath.getTotalLength();
    const returnLength = returnPath.getTotalLength();

    // Prepare illuminated path with stroke-dasharray
    illuminatedPath.style.strokeDasharray = `${forwardLength}`;
    illuminatedPath.style.strokeDashoffset = `${forwardLength}`;

    // Precise node milestone percentages on forward path:
    // Node 1: 0.00, Node 2: 0.245, Node 3: 0.501, Node 4: 0.761, Node 5: 1.00
    const stages = [
      { progress: 0.000, flagId: 'flag1', nodeId: 'node1', title: '1. Creator Talent Benchmarking' },
      { progress: 0.245, flagId: 'flag2', nodeId: 'node2', title: '2. Outreaching to Brands' },
      { progress: 0.501, flagId: 'flag3', nodeId: 'node3', title: '3. Brand Response & Terms Locked' },
      { progress: 0.761, flagId: 'flag4', nodeId: 'node4', title: '4. Content Production & 48h SLA' },
      { progress: 0.995, flagId: 'flag5', nodeId: 'node5', title: '5. Sponsorship Delivery & Payout' },
    ];

    const cards = document.querySelectorAll('.wf-label-card');

    let isPlaying = true;
    let isVisible = true;
    let animationFrameId: number;
    let startTime: number | null = null;

    // Durations:
    // Forward trip: 7.2s with smooth ease-in gathering kinetic momentum along the curve
    // Hold at destination: 1.0s
    // Fast Rewind Return: 0.45s (snappy quick return as requested)
    const FORWARD_DURATION = 7200;
    const HOLD_DURATION = 1000;
    const RETURN_DURATION = 450; // Fast return
    const TOTAL_CYCLE = FORWARD_DURATION + HOLD_DURATION + RETURN_DURATION;

    // IntersectionObserver to only animate when user sees it
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible && isPlaying) {
        startTime = null;
        animationFrameId = requestAnimationFrame(animateStep);
      } else {
        cancelAnimationFrame(animationFrameId);
      }
    }, { threshold: 0.15 });

    observer.observe(section);

    function updateFlagsAndNodes(pct: number, isForward: boolean) {
      stages.forEach((st, idx) => {
        const flagEl = document.getElementById(st.flagId);
        const nodeEl = document.getElementById(st.nodeId);
        const cardEl = cards[idx] as HTMLElement | null;

        if (isForward && pct >= st.progress - 0.015) {
          flagEl?.classList.add('raised');
          nodeEl?.classList.add('active-node');
          cardEl?.classList.add('active-card');
        } else if (!isForward) {
          // Rewind reset
          flagEl?.classList.remove('raised');
          nodeEl?.classList.remove('active-node');
          cardEl?.classList.remove('active-card');
        } else {
          flagEl?.classList.remove('raised');
          nodeEl?.classList.remove('active-node');
          cardEl?.classList.remove('active-card');
        }
      });
    }

    function updateStageTitle(pct: number) {
      if (!stageBadge) return;
      if (pct < 0.245) {
        stageBadge.textContent = stages[0].title;
      } else if (pct < 0.501) {
        stageBadge.textContent = stages[1].title;
      } else if (pct < 0.761) {
        stageBadge.textContent = stages[2].title;
      } else if (pct < 0.99) {
        stageBadge.textContent = stages[3].title;
      } else {
        stageBadge.textContent = stages[4].title;
      }
    }

    function animateStep(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const elapsed = (timestamp - startTime) % TOTAL_CYCLE;

      if (elapsed < FORWARD_DURATION) {
        // Forward traveling with Ease-In curve (User: "make the going in ease in and make it sync with the curve")
        const tLinear = elapsed / FORWARD_DURATION;
        // Ease-In acceleration (starts gentle, accelerates through the curve)
        const tEased = Math.pow(tLinear, 1.32);
        const currentDistance = tEased * forwardLength;
        const point = faintPath.getPointAtLength(currentDistance);

        // Calculate smooth directional tangent from surrounding path points for precision curve alignment
        const pBefore = faintPath.getPointAtLength(Math.max(0, currentDistance - 4));
        const pAfter = faintPath.getPointAtLength(Math.min(forwardLength, currentDistance + 4));
        const angle = Math.atan2(pAfter.y - pBefore.y, pAfter.x - pBefore.x) * (180 / Math.PI);

        arrow.setAttribute('transform', `translate(${point.x}, ${point.y}) rotate(${angle})`);

        // Reveal illuminated green dotted path up to arrow position
        illuminatedPath.style.strokeDashoffset = `${forwardLength - currentDistance}`;

        updateFlagsAndNodes(tEased, true);
        updateStageTitle(tEased);

        if (progressFill) {
          progressFill.style.width = `${tEased * 100}%`;
        }
      } else if (elapsed < FORWARD_DURATION + HOLD_DURATION) {
        // Final Hold at Node 5
        const endPoint = faintPath.getPointAtLength(forwardLength);
        arrow.setAttribute('transform', `translate(${endPoint.x}, ${endPoint.y}) rotate(0)`);
        illuminatedPath.style.strokeDashoffset = '0';
        updateFlagsAndNodes(1.0, true);
        if (stageBadge) stageBadge.textContent = "5. Sponsorships Complete • Verified & Paid!";
        if (progressFill) progressFill.style.width = '100%';
      } else {
        // Fast Rewind Return Arc (User: "make the arrow go back fast")
        const returnElapsed = elapsed - (FORWARD_DURATION + HOLD_DURATION);
        const tReturnLinear = returnElapsed / RETURN_DURATION;
        // Snappy fast ease
        const tReturnEased = 1 - Math.pow(1 - tReturnLinear, 2.2);
        const returnDist = tReturnEased * returnLength;
        const point = returnPath.getPointAtLength(returnDist);

        const pBefore = returnPath.getPointAtLength(Math.max(0, returnDist - 4));
        const pAfter = returnPath.getPointAtLength(Math.min(returnLength, returnDist + 4));
        const angle = Math.atan2(pAfter.y - pBefore.y, pAfter.x - pBefore.x) * (180 / Math.PI);

        arrow.setAttribute('transform', `translate(${point.x}, ${point.y}) rotate(${angle})`);

        // Rapid reset illuminated path during return
        illuminatedPath.style.strokeDashoffset = `${forwardLength * (1 - (1 - tReturnLinear))}`;

        updateFlagsAndNodes(0, false);
        if (stageBadge) stageBadge.textContent = "Resetting Pipeline for Next Creator...";
        if (progressFill) progressFill.style.width = `${(1 - tReturnLinear) * 100}%`;
      }

      if (isPlaying && isVisible) {
        animationFrameId = requestAnimationFrame(animateStep);
      }
    }

    // Pause / Resume interaction
    btnPause?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        if (pauseIcon) pauseIcon.textContent = '⏸';
        if (pauseText) pauseText.textContent = 'Pause Motion';
        startTime = null;
        animationFrameId = requestAnimationFrame(animateStep);
      } else {
        if (pauseIcon) pauseIcon.textContent = '▶';
        if (pauseText) pauseText.textContent = 'Resume Motion';
        cancelAnimationFrame(animationFrameId);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initZyoleKaiWorkflow);
  document.addEventListener('astro:page-load', initZyoleKaiWorkflow);
</script>

<style>
  .workflow-section {
    padding: 44px 36px;
    margin: 56px auto 0 auto;
    max-width: 1140px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid rgba(13, 28, 18, 0.12);
    box-shadow: 0 16px 44px rgba(13, 28, 18, 0.06);
    position: relative;
    overflow: hidden;
  }

  .workflow-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 32px auto;
  }

  .workflow-kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 191, 99, 0.08);
    border: 1px solid rgba(0, 191, 99, 0.22);
    padding: 5px 14px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    color: #008744;
    margin-bottom: 14px;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 10px var(--brand-green);
    animation: liveDotPulse 1.8s ease-in-out infinite;
  }

  @keyframes liveDotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .workflow-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }

  .workflow-subtitle {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .active-stage-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1.5px solid rgba(0, 191, 99, 0.3);
    box-shadow: 0 4px 16px rgba(0, 191, 99, 0.12);
    padding: 8px 20px;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
  }

  .indicator-prefix {
    color: var(--text-muted);
    font-weight: 600;
  }

  .indicator-name {
    color: #008744;
    font-weight: 800;
    font-family: var(--font-display);
  }

  /* SVG Canvas Styling */
  .workflow-canvas-container {
    position: relative;
    width: 100%;
    margin-bottom: 24px;
  }

  .workflow-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Faint Guide Path */
  .path-base-faint {
    stroke: rgba(13, 28, 18, 0.14);
    stroke-width: 3.5;
    stroke-dasharray: 6 8;
    fill: none;
    transition: stroke 200ms ease;
  }

  /* Active Illuminated Path */
  .path-active-illuminated {
    stroke: url(#wfActiveGlow);
    stroke-width: 4;
    stroke-dasharray: 6 8;
    stroke-linecap: round;
    fill: none;
    filter: drop-shadow(0 0 6px rgba(0, 191, 99, 0.55));
  }

  /* Quick Return Path (Hidden from user sight, guides arrow rewind) */
  .path-return-arc {
    stroke: transparent;
    stroke-width: 1;
    fill: none;
  }

  /* Arrow Traveler */
  .arrow-traveler {
    cursor: pointer;
    transition: filter 200ms ease;
  }

  .arrow-beacon-ring {
    animation: beaconPulse 1.4s ease-out infinite;
  }

  @keyframes beaconPulse {
    0% { r: 8; opacity: 0.85; }
    100% { r: 24; opacity: 0; }
  }

  /* Nodes */
  .wf-node {
    cursor: pointer;
    transition: transform 220ms var(--ease-spring);
  }

  .node-bg-circle {
    fill: #FFFFFF;
    stroke: rgba(13, 28, 18, 0.14);
    stroke-width: 2.2;
    transition: stroke 240ms ease, fill 240ms ease;
  }

  .node-glow-ring {
    fill: none;
    stroke: transparent;
    stroke-width: 4;
    transition: stroke 240ms ease;
  }

  .wf-node.active-node .node-bg-circle {
    stroke: var(--brand-green);
    fill: #FFFFFF;
  }

