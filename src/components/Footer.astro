          <li><a href="#sponsorships">Brand Video Deals</a></li>
          <li><a href="#sponsorships">Minecraft SMP Series</a></li>
          <li><a href="#sponsorships">Cloud Hosting Perks</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Ecosystem -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Ecosystem</h4>
        <ul>
          <li><a href="#community">Discord Network</a></li>
          <li><a href="#community">Server Alliances</a></li>
          <li><a href="#faq">Knowledgebase & FAQs</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Support Desk</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Direct Desks -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Direct Desks</h4>
        <ul>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Creator Verification</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Sponsor Handlers</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Alliance Applications</a></li>
