        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright-text">
        © {new Date().getFullYear()} ZyoleKai Organization. Built with Precision.
      </p>
      <div class="footer-status-pill">
        <span class="status-dot"></span>
        <span>Systems Operational • Discord V2 Connected</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: #04060A;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 80px 0 36px 0;
    position: relative;
    z-index: 1;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 60px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .footer-logo {
    border-radius: 50%;
    object-fit: contain;
  }

  .footer-wordmark {
    object-fit: contain;
  }

  .footer-tagline {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 380px;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-card);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-icon:hover {
      background: var(--brand-green);
      color: #061208;
      border-color: var(--brand-green);
      transform: translateY(-2px);
    }
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin-bottom: 18px;
  }

  .footer-links-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links-col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links-col a:hover {
    color: var(--brand-green);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-status-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 8px var(--brand-green);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .footer-wrapper {
      padding: 56px 0 28px 0;
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .social-icon {
      width: 44px;
      height: 44px;
    }
    .footer-links-col a {
      min-height: 36px;
      display: inline-flex;
      align-items: center;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
