---
// Footer.astro - Emil Kowalski Craft Standards
---

<footer class="footer-wrapper">
  <!-- Borderless Blended Banner Masterpiece -->
  <div class="footer-banner-showcase" aria-label="ZyoleKai Brand Signature">
    <!-- Precision Corner Waves Blending with Canvas -->
    <img src="/brand/corner_wave_tl.png" alt="" class="footer-wave wave-tl" aria-hidden="true" />
    <img src="/brand/corner_wave_tr.png" alt="" class="footer-wave wave-tr" aria-hidden="true" />
    <img src="/brand/corner_wave_bl.png" alt="" class="footer-wave wave-bl" aria-hidden="true" />
    <img src="/brand/corner_wave_br.png" alt="" class="footer-wave wave-br" aria-hidden="true" />

    <!-- Ambient Emerald Aura Glow (Zero Rectangular Box or Hard Grids) -->
    <div class="footer-ambient-aura" aria-hidden="true"></div>

    <div class="container footer-banner-container">
      <!-- Floating Talent Proof Chip 1 -->
      <div class="footer-chip chip-left float-anim-1">
        <img src="https://yt3.googleusercontent.com/7-JXzXEzN1OoTsCTGN_tkgj2qnMnEs3Kch5zfdA1LO8hZkTrmCHFOU-V-ibYpAZcVVweUlKP=s900-c-k-c0x00ffffff-no-rj" alt="SenpaiSpider" class="f-chip-avatar" onerror="this.src='/brand/logo.png'" />
        <div class="f-chip-info">
          <div class="f-chip-row">
            <span class="f-chip-title">SenpaiSpider</span>
            <span class="f-chip-badge">2.69M Subs</span>
          </div>
          <span class="f-chip-sub">Viral Minecraft Content</span>
        </div>
      </div>

      <!-- Centerpiece Content with Exact 1:1 Transparent Wordmark & Slogan -->
      <div class="footer-brand-center">
        <div class="footer-emblem-wrap">
          <img src="/brand/logo.png" alt="ZyoleKai 3D Emblem" class="footer-emblem" />
          <div class="footer-emblem-glow"></div>
        </div>

        <div class="footer-brand-text">
          <img src="/brand/exact_zyolekai_logo.png" alt="ZyoleKai" class="footer-brand-wordmark" />
          <img src="/brand/exact_slogan.png" alt="Built For Perfection." class="footer-brand-slogan" />
          <p class="footer-kicker">GAMING TALENT MANAGEMENT & SPONSORSHIPS</p>
          <p class="footer-subline">REPRESENTING 15 CREATORS • YOUTUBE INTEGRATIONS • SMP EVENT SERIES</p>
        </div>
      </div>

      <!-- Floating Talent Proof Chip 2 -->
      <div class="footer-chip chip-right float-anim-2">
        <img src="https://yt3.googleusercontent.com/YRiuDwpUPZ_JY7p_rucfwgXqvzaJ3AyU0MvTI0Qmcr5hbPUoK1BHatq4T00Jo2NWLxTQw5TpAA=s900-c-k-c0x00ffffff-no-rj" alt="Mc flame" class="f-chip-avatar" onerror="this.src='/brand/logo.png'" />
        <div class="f-chip-info">
          <div class="f-chip-row">
            <span class="f-chip-title">Mc flame</span>
            <span class="f-chip-badge">2.69M Subs</span>
          </div>
          <span class="f-chip-sub">Storytelling & Roleplay</span>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-divider-curve"></div>

  <div class="container footer-container">
    <div class="footer-top">
      <!-- Brand column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo-link">
          <img src="/brand/logo.png" alt="ZyoleKai Emblem" class="footer-logo" width="40" height="40" />
          <div class="footer-brand-lockup">
            <img src="/brand/wordmark.png" alt="ZyoleKai" class="footer-wordmark" height="24" />
            <img src="/brand/exact_slogan.png" alt="Built For Perfection." class="footer-slogan" height="14" />
          </div>
        </a>
        <p class="footer-tagline">
          Gaming talent management representing creators across YouTube and Twitch. Connecting gaming channels with brand sponsorships, server partnerships, and SMP series.
        </p>
        <div class="social-links">
          <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Discord Server">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </a>
          <a href="https://youtube.com/@zyolekai" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="YouTube Channel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 22c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 2c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/>
            </svg>
          </a>
          <a href="https://instagram.com/zyolekai" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links Column 1: Platform -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Agency</h4>
        <ul>
          <li><a href="#roster">Creator Talent Roster</a></li>
          <li><a href="#sponsorships">YouTube Integrations</a></li>
          <li><a href="#sponsorships">Minecraft SMP Series</a></li>
          <li><a href="#sponsorships">Hosting Partnerships</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Community -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Community</h4>
        <ul>
          <li><a href="#community">Official Discord Server</a></li>
          <li><a href="#community">Server Partnerships</a></li>
          <li><a href="#faq">Frequently Asked Questions</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Support Desk</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Contact Desks -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Discord Desks</h4>
        <ul>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Creator Verification</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Sponsorship Desk</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Server Alliances</a></li>
          <li><a href="https://discord.gg/zyolekai" target="_blank">Executive Inquiries</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright-text">
        © {new Date().getFullYear()} ZyoleKai. Non-exclusive gaming creator representation.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: var(--bg-canvas);
    border-top: none;
    padding: 0 0 36px 0;
    position: relative;
    z-index: 1;
  }

  /* Borderless Blended Banner Masterpiece (Footer Area) */
  .footer-banner-showcase {
    position: relative;
    overflow: hidden;
    padding: 40px 20px 60px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: transparent;
  }

  .footer-wave {
    position: absolute;
    pointer-events: none;
    z-index: 1;
    opacity: 0.82;
    filter: drop-shadow(0 4px 20px rgba(0, 191, 99, 0.18));
  }

  .footer-wave.wave-tl {
    top: 0;
    left: 0;
    width: 30%;
    max-width: 360px;
  }

  .footer-wave.wave-tr {
    top: 0;
    right: 0;
    width: 32%;
    max-width: 380px;
  }

  .footer-wave.wave-bl {
    bottom: 0;
    left: 0;
    width: 28%;
    max-width: 340px;
  }

  .footer-wave.wave-br {
    bottom: 0;
    right: 0;
    width: 30%;
    max-width: 360px;
  }

  .footer-ambient-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(circle at 50% 50%, rgba(0, 191, 99, 0.08) 0%, rgba(126, 217, 87, 0.04) 40%, transparent 70%);
  }

  .footer-banner-container {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    max-width: 1200px;
    width: 100%;
  }

  .footer-brand-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 600px;
  }

  .footer-emblem-wrap {
    position: relative;
    width: 74px;
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: floatEmblem 4.5s ease-in-out infinite;
  }

  @keyframes floatEmblem {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-7px) rotate(1.5deg); }
  }

  .footer-emblem {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 8px 22px rgba(0, 191, 99, 0.45));
  }

  .footer-emblem-glow {
    position: absolute;
    inset: -12px;
    background: radial-gradient(circle, rgba(0, 191, 99, 0.35) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(14px);
    z-index: 1;
    pointer-events: none;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .footer-brand-wordmark {
    max-width: 380px;
    width: 90%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 18px rgba(0, 191, 99, 0.28));
  }

  .footer-brand-slogan {
    max-width: 310px;
    width: 80%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 10px rgba(0, 191, 99, 0.2));
  }

  .footer-kicker {
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--brand-green);
    text-transform: uppercase;
    margin-top: 4px;
  }

  .footer-subline {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    text-transform: uppercase;
    max-width: 520px;
    line-height: 1.5;
  }

  /* Floating Chips */
  .footer-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid rgba(13, 28, 18, 0.1);
    box-shadow: 0 10px 28px rgba(13, 28, 18, 0.08);
    padding: 12px 18px;
    border-radius: var(--radius-md);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform var(--duration-fast) var(--ease-spring),
                box-shadow var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    user-select: none;
  }

  .footer-chip:hover {
    transform: translateY(-4px) scale(1.03) !important;
    border-color: var(--brand-green);
    box-shadow: 0 16px 36px rgba(0, 191, 99, 0.22);
  }

  .f-chip-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid var(--brand-green);
    object-fit: cover;
  }

  .f-chip-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .f-chip-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .f-chip-title {
    font-family: var(--font-display);
    font-size: 0.90rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .f-chip-badge {
    background: rgba(0, 191, 99, 0.1);
    color: var(--brand-green);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(0, 191, 99, 0.25);
  }

  .f-chip-sub {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .float-anim-1 {
    animation: floatChip1 5s ease-in-out infinite;
  }

  .float-anim-2 {
    animation: floatChip2 6s ease-in-out 1s infinite;
  }

  @keyframes floatChip1 {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }

  @keyframes floatChip2 {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  .footer-divider-curve {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(13, 28, 18, 0.1) 30%, rgba(13, 28, 18, 0.1) 70%, transparent 100%);
    margin-bottom: 56px;
  }

  @media (max-width: 990px) {
    .footer-chip {
      display: none;
    }
    .footer-banner-showcase {
      padding: 48px 16px 54px 16px;
    }
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 60px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .footer-logo {
    border-radius: 50%;
    object-fit: contain;
  }

  .footer-wordmark {
    object-fit: contain;
  }

  .footer-brand-lockup {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-slogan {
    max-width: 170px;
    object-fit: contain;
    opacity: 0.9;
  }

  .footer-tagline {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 380px;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-card);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-icon:hover {
      background: var(--brand-green);
      color: #061208;
      border-color: var(--brand-green);
      transform: translateY(-2px);
    }
  }

  .footer-col-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin-bottom: 18px;
  }

  .footer-links-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links-col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links-col a:hover {
    color: var(--brand-green);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 32px;
    border-top: 1px solid rgba(13, 28, 18, 0.08);
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .footer-wrapper {
      padding: 56px 0 28px 0;
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .social-icon {
      width: 44px;
      height: 44px;
    }
    .footer-links-col a {
      min-height: 36px;
      display: inline-flex;
      align-items: center;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
