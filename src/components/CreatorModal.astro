---
// CreatorModal.astro - Emil Kowalski Craft Standards
---

<div id="creatorModal" class="modal-backdrop" aria-hidden="true" role="dialog">
  <div class="modal-dialog glass-card" id="modalDialog">
    <button class="modal-close" id="modalCloseBtn" aria-label="Close modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-body" id="modalBody">
      <!-- Dynamically filled by JavaScript -->
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(4, 7, 12, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-dialog {
    width: 100%;
    max-width: 760px;
    background: rgba(255, 255, 255, 0.98);
    border: 1.5px solid rgba(0, 191, 99, 0.25);
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 60px rgba(13, 28, 18, 0.18);
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px;
    opacity: 0;
    transform: scale(0.96);
    transform-origin: center center;
    transition: transform var(--duration-normal) var(--ease-out),
                opacity var(--duration-normal) var(--ease-out);
  }

  .modal-backdrop.open .modal-dialog {
    opacity: 1;
    transform: scale(1);
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-card);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .modal-close:active {
    transform: scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-dialog {
      transform: none !important;
    }
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
  }
</style>

<script>
  const backdrop = document.getElementById('creatorModal');
  const dialog = document.getElementById('modalDialog');
  const closeBtn = document.getElementById('modalCloseBtn');
  const modalBody = document.getElementById('modalBody');

  function closeModal() {
    if (backdrop) {
      backdrop.classList.remove('open');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  if (closeBtn && backdrop) {
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('open')) {
        closeModal();
      }
    });
  }

  // Global trigger function
  window.openCreatorModal = function(creatorData) {
    if (!backdrop || !modalBody) return;

    modalBody.innerHTML = `
      <div class="creator-modal-content">
        <div class="modal-header">
          <img src="${creatorData.avatar || '/brand/logo.png'}" alt="${creatorData.name}" class="modal-avatar" />
          <div class="modal-header-info">
            <div class="modal-title-row">
              <h2 class="modal-name">${creatorData.name}</h2>
              <span class="verified-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:2px;">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>Verified
              </span>
            </div>
            <p class="modal-niche">${creatorData.niche || 'Gaming Entertainment'} • ${creatorData.videoCount || '50+ videos'}</p>
          </div>
        </div>

        <div class="modal-media-kit-preview">
          <img src="/creators/card_${creatorData.id}.png" alt="${creatorData.name} Media Kit Card" class="modal-card-img" onerror="this.style.display='none'" />
        </div>

        <div class="modal-stats-grid">
          <div class="modal-stat-box">
            <span class="stat-box-label">Subscribers</span>
            <span class="stat-box-val">${creatorData.subscribers || 'N/A'}</span>
          </div>
          <div class="modal-stat-box">
            <span class="stat-box-label">Average Views (Verified)</span>
            <span class="stat-box-val">${creatorData.avgViews || '50,000+'}</span>
          </div>
          <div class="modal-stat-box">
            <span class="stat-box-label">Content Catalog</span>
            <span class="stat-box-val">${creatorData.videoCount || '50+ uploads'}</span>
          </div>
        </div>

        <div class="modal-match-box">
          <h4 class="match-heading">Available Campaign Formats</h4>
          <p class="match-text"><strong>Dedicated Video Placements & SMP Event Series</strong></p>
          <p class="match-pitch">High audience retention, consistent uploads, and engaged viewer community across YouTube and gaming content.</p>
        </div>

        <div class="modal-actions">
          <a href="${creatorData.youtubeUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <span>View Channel</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-left:4px;">
              <path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 22c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 2c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/>
            </svg>
          </a>
          <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>Inquire About ${creatorData.name}</span>
          </a>
        </div>
      </div>
    `;

    backdrop.classList.add('open');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };
</script>

<style is:global>
  .creator-modal-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .modal-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .modal-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--brand-green);
    object-fit: cover;
  }

  .modal-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .modal-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .verified-badge {
    background: rgba(83, 212, 62, 0.15);
    color: var(--brand-green);
    border: 1px solid var(--border-brand);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .modal-niche {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .modal-card-img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-card);
    display: block;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  }

  .modal-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .modal-stat-box {
    background: #FAF7EE;
    border: 1px solid rgba(13, 28, 18, 0.08);
    padding: 14px;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-box-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 600;
  }

  .stat-box-val {
    font-family: var(--font-display);
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .modal-match-box {
    background: rgba(0, 191, 99, 0.08);
    border: 1px solid rgba(0, 191, 99, 0.22);
    padding: 16px;
    border-radius: var(--radius-md);
  }

  .match-heading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-green);
    margin-bottom: 6px;
  }

  .match-text {
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .match-pitch {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .modal-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .modal-dialog {
      padding: 24px 18px 20px 18px;
      max-height: 88vh;
    }
    .modal-header {
      gap: 12px;
    }
    .modal-avatar {
      width: 52px;
      height: 52px;
    }
    .modal-name {
      font-size: 1.3rem;
    }
    .modal-stats-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .modal-stat-box {
      padding: 10px 14px;
    }
    .modal-actions {
      flex-direction: column;
      gap: 10px;
    }
    .modal-actions .btn {
      width: 100%;
      min-height: 44px;
    }
    .modal-close {
      top: 14px;
      right: 14px;
      width: 40px;
      height: 40px;
    }
  }
</style>
