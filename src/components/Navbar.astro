---
// Navbar.astro - Emil Kowalski Craft Standards
---

<header class="navbar-wrapper">
  <nav class="navbar glass-card">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="ZyoleKai Home">
      <img src="/brand/logo.png" alt="ZyoleKai Emblem" class="brand-emblem" width="36" height="36" />
      <img src="/brand/wordmark.png" alt="ZyoleKai Wordmark" class="brand-wordmark" height="24" />
    </a>

    <!-- Desktop Navigation Links -->
    <div class="nav-links">
      <a href="#roster" class="nav-item">Talent Roster</a>
      <a href="#sponsorships" class="nav-item">Sponsorships</a>
      <a href="#community" class="nav-item">Community</a>
      <a href="#faq" class="nav-item">Knowledgebase</a>
    </div>

    <!-- Actions -->
    <div class="nav-actions">
      <div class="live-badge" title="Active Roster Network">
        <span class="live-dot"></span>
        <span class="live-text">15 Verified Creators</span>
      </div>
      
      <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Join Discord</span>
      </a>

      <!-- Mobile Menu Button -->
      <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle Menu">
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <a href="#roster" class="drawer-item">Talent Roster</a>
    <a href="#sponsorships" class="drawer-item">Sponsorships</a>
    <a href="#community" class="drawer-item">Community</a>
    <a href="#faq" class="drawer-item">Knowledgebase</a>
    <a href="https://discord.gg/zyolekai" target="_blank" class="btn btn-primary" style="margin-top: 12px; width: 100%;">
      Join Discord Server
    </a>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 20px;
    display: flex;
    justify-content: center;
  }

  .navbar {
    width: 100%;
    max-width: 1180px;
    height: 64px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(11, 15, 23, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    border-radius: var(--radius-full);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-emblem {
    border-radius: 50%;
    object-fit: contain;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand-link:hover .brand-emblem {
      transform: rotate(12deg) scale(1.05);
    }
  }

  .brand-wordmark {
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-item {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
    position: relative;
    padding: 4px 0;
  }

  .nav-item:hover {
    color: var(--text-primary);
  }

  .nav-item::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--brand-green);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .nav-item:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(83, 212, 62, 0.08);
    border: 1px solid rgba(83, 212, 62, 0.2);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand-green);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 10px var(--brand-green);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .mobile-toggle .bar {
    width: 20px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .mobile-toggle.active .bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-toggle.active .bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-drawer {
    display: none;
    position: absolute;
    top: 76px;
    left: 20px;
    right: 20px;
    background: rgba(14, 19, 31, 0.96);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 20px;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--shadow-lg);
    transform-origin: top center;
    transform: scale(0.95);
    opacity: 0;
    pointer-events: none;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .mobile-drawer.open {
    display: flex;
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-item {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 880px) {
    .nav-links, .live-badge {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .navbar {
      height: 56px;
      padding: 0 12px;
    }
    .navbar-wrapper {
      top: 10px;
      padding: 0 10px;
    }
    .brand-wordmark {
      height: 18px;
    }
    .brand-emblem {
      width: 28px;
      height: 28px;
    }
    .nav-actions .btn-pill span {
      display: none;
    }
    .nav-actions .btn-pill {
      padding: 8px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      btn.classList.toggle('active', isOpen);
    });

    // Close when clicking any drawer item
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('open');
        btn.classList.remove('active');
      });
    });
  }
</script>
