---
import '../styles/design-tokens.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CreatorModal from '../components/CreatorModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "ZyoleKai • Gaming Talent Management & Brand Partnerships",
  description = "ZyoleKai represents 15 gaming creators with over 6.5M combined subscribers. We manage YouTube sponsorships, Minecraft SMP events, and brand partnerships.",
  image = "/brand/hero_banner.png"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="ZyoleKai, creator agency, gaming sponsorships, Minecraft SMP, YouTubers, streamer deals, brand integrations, esports network" />
    <meta name="author" content="ZyoleKai Organization" />

    <!-- Google Fonts: Outfit (Display) & Plus Jakarta Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Asset Preloads -->
    <link rel="preload" href="/brand/logo.png" as="image" type="image/png" />
    <link rel="preload" href="/brand/wordmark.png" as="image" type="image/png" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zyolekai.vercel.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://zyolekai.vercel.app" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body>
    <!-- WCAG Priority 1: Skip to main content -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="ambient-mesh" aria-hidden="true"></div>
    
    <!-- Real Chroma-Keyed Organic Waves Extracted from Official Banner -->
    <div class="banner-waves-bg" aria-hidden="true">
      <img src="/brand/corner_wave_tl.png" alt="" class="bg-wave-elem wave-tl" />
      <img src="/brand/corner_wave_tr.png" alt="" class="bg-wave-elem wave-tr" />
      <img src="/brand/corner_wave_bl.png" alt="" class="bg-wave-elem wave-bl" />
      <img src="/brand/corner_wave_br.png" alt="" class="bg-wave-elem wave-br" />
    </div>

    <Navbar />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <CreatorModal />
  </body>
</html>
