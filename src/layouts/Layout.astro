---
import '../styles/design-tokens.css';
import { ClientRouter, type TransitionDirectionalAnimations } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CreatorModal from '../components/CreatorModal.astro';

// Codrops PageTransitions 1:1 Directional Animations
// Reference: https://tympanus.net/Development/PageTransitions/
export const codropsSlide: TransitionDirectionalAnimations = {
  forwards: {
    old: {
      name: 'ptMoveToLeft',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    },
    new: {
      name: 'ptMoveFromRight',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    }
  },
  backwards: {
    old: {
      name: 'ptMoveToRight',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    },
    new: {
      name: 'ptMoveFromLeft',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    }
  }
};

export const codropsZoom: TransitionDirectionalAnimations = {
  forwards: {
    old: {
      name: 'ptScaleDown',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    },
    new: {
      name: 'ptZoomIn',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    }
  },
  backwards: {
    old: {
      name: 'ptZoomOut',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    },
    new: {
      name: 'ptScaleUp',
      duration: '0.6s',
      easing: 'cubic-bezier(0.7, 0, 0.3, 1)',
      fillMode: 'both'
    }
  }
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  transitionType?: 'slide' | 'zoom';
}

const {
  title = "ZyoleKai • Gaming Talent Management & Brand Partnerships",
  description = "ZyoleKai represents 15 gaming creators with over 6.5M combined subscribers. We manage YouTube sponsorships, Minecraft SMP events, and brand partnerships.",
  image = "/brand/hero_banner.png",
  transitionType = 'slide'
} = Astro.props;

const activeTransition = transitionType === 'zoom' ? codropsZoom : codropsSlide;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="ZyoleKai, creator agency, gaming sponsorships, Minecraft SMP, YouTubers, streamer deals, brand integrations, esports network" />
    <meta name="author" content="ZyoleKai Organization" />

    <!-- Google Fonts: Asynchronous Non-Blocking Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    </noscript>

    <!-- Asset Preloads -->
    <link rel="preload" href="/brand/logo.webp" as="image" type="image/webp" />
    <link rel="preload" href="/brand/wordmark.webp" as="image" type="image/webp" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zyolekai.vercel.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://zyolekai.vercel.app" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Astro View Transitions for Client-side Navigation -->
    <ClientRouter />
  </head>
  <body>
    <!-- Humanized SVG Architecture Brand Gradients -->
    <svg width="0" height="0" class="svg-defs" aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
      <defs>
        <linearGradient id="emeraldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00BF63" />
          <stop offset="100%" stop-color="#007A3D" />
        </linearGradient>
        <linearGradient id="emeraldGradGlow" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#53D43E" />
          <stop offset="100%" stop-color="#00BF63" />
        </linearGradient>
        <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FACC15" />
          <stop offset="100%" stop-color="#CA8A04" />
        </linearGradient>
      </defs>
    </svg>

    <!-- WCAG Priority 1: Skip to main content -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="ambient-mesh" aria-hidden="true"></div>
    
    <!-- Real Chroma-Keyed Organic Waves Extracted from Official Banner -->
    <div class="banner-waves-bg" aria-hidden="true">
      <img src="/brand/corner_wave_tl.webp" alt="" class="bg-wave-elem wave-tl" width="1743" height="969" />
      <img src="/brand/corner_wave_tr.webp" alt="" class="bg-wave-elem wave-tr" width="1438" height="177" />
      <img src="/brand/corner_wave_bl.webp" alt="" class="bg-wave-elem wave-bl" width="1541" height="168" />
      <img src="/brand/corner_wave_br.webp" alt="" class="bg-wave-elem wave-br" width="1636" height="864" />
    </div>

    <Navbar />
    
    <main id="main-content" transition:name="main-content" transition:animate={activeTransition}>
      <slot />
    </main>

    <Footer />
    <CreatorModal />

    <script>
      // Codrops Page Transition Controller
      // 1. Move to Left / Move to Right (Slide) between standard pages (0.6s)
      // 2. Zoom In / Zoom Out for Viewing Creator Media Kit (0.6s)
      function determineTransition(fromPath: string, toPath: string, direction?: string): string {
        const isEnteringMediaKit = toPath.startsWith('/roster/') && toPath !== '/roster' && toPath !== '/roster/';
        const isExitingMediaKit = fromPath.startsWith('/roster/') && fromPath !== '/roster' && fromPath !== '/roster/';

        if (isEnteringMediaKit) return 'zoom-in';
        if (isExitingMediaKit && (toPath === '/roster' || toPath === '/roster/' || toPath === '')) return 'zoom-out';
        if (direction === 'back') return 'slide-right';
        return 'slide-left';
      }

      document.addEventListener('astro:before-preparation', (event: any) => {
        const fromPath = (event.from ? event.from.pathname : window.location.pathname).replace(/\/$/, '') || '/';
        const toPath = (event.to ? event.to.pathname : '').replace(/\/$/, '') || '/';
        const transitionType = determineTransition(fromPath, toPath, event.direction);

        document.documentElement.setAttribute('data-transition', transitionType);
      });

      // Crucial: Copy data-transition to new incoming document so View Transitions selectors match!
      document.addEventListener('astro:before-swap', (event: any) => {
        const currentTransition = document.documentElement.getAttribute('data-transition');
        if (currentTransition && event.newDocument) {
          event.newDocument.documentElement.setAttribute('data-transition', currentTransition);
        }
      });

      // Immediate pre-click detection to prime data-transition before snapshot
      document.addEventListener('click', (e: MouseEvent) => {
        const target = (e.target as HTMLElement)?.closest('a');
        if (!target) return;
        const href = target.getAttribute('href') || '';
        const customTransition = target.getAttribute('data-transition');

        if (customTransition) {
          document.documentElement.setAttribute('data-transition', customTransition);
          return;
        }

        const fromPath = window.location.pathname.replace(/\/$/, '') || '/';
        const toPath = href.replace(/\/$/, '') || '/';
        if (toPath.startsWith('/')) {
          const transitionType = determineTransition(fromPath, toPath);
          document.documentElement.setAttribute('data-transition', transitionType);
        }
      });

      document.addEventListener('astro:page-load', () => {
        // Keep data-transition active throughout the 600ms transition, then clean up
        setTimeout(() => {
          document.documentElement.removeAttribute('data-transition');
        }, 650);
      });

      // Paper Plane Flight & Animated Play/Pause Microinteractions
      function launchPaperPlane(x: number, y: number) {
        const plane = document.createElement('div');
        plane.className = 'paper-plane-flyer';
        plane.style.left = `${x}px`;
        plane.style.top = `${y}px`;
        plane.innerHTML = `
          <svg width="26" height="26" viewBox="0 0 24 24" fill="#00BF63" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
        `;
        document.body.appendChild(plane);
        plane.addEventListener('animationend', () => plane.remove());
      }

      function spawnEmojiPop(x: number, y: number, emoji1 = '▶️', emoji2 = '⏸️') {
        const pop = document.createElement('div');
        pop.className = 'btn-emoji-pop';
        pop.style.left = `${x}px`;
        pop.style.top = `${y}px`;
        pop.innerHTML = `<span>${emoji1}</span><span>✈️</span>`;
        document.body.appendChild(pop);
        setTimeout(() => {
          const first = pop.querySelector('span');
          if (first) first.textContent = emoji2;
        }, 180);
        pop.addEventListener('animationend', () => pop.remove());
      }

      // Attach to interactive buttons
      document.addEventListener('click', (e: MouseEvent) => {
        const target = (e.target as HTMLElement)?.closest('button, .btn, .pill-btn, .open-kit-btn, .yt-btn, .social-icon');
        if (!target) return;

        const rect = target.getBoundingClientRect();
        const clickX = e.clientX || (rect.left + rect.width / 2);
        const clickY = e.clientY || (rect.top + rect.height / 2);

        launchPaperPlane(clickX, clickY);
        spawnEmojiPop(rect.left + rect.width / 2, rect.top);
      });
    </script>
  </body>
</html>

<style is:global>
  /* Codrops PageTransitions 1:1 Keyframes */
  @keyframes ptMoveToLeft {
    from { transform: translateX(0%); }
    to { transform: translateX(-100%); }
  }

  @keyframes ptMoveFromRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0%); }
  }

  @keyframes ptMoveToRight {
    from { transform: translateX(0%); }
    to { transform: translateX(100%); }
  }

  @keyframes ptMoveFromLeft {
    from { transform: translateX(-100%); }
    to { transform: translateX(0%); }
  }

  /* Codrops Animation 21: Scale Down */
  @keyframes ptScaleDown {
    from { transform: scale(1); opacity: 1; }
    to { transform: scale(0.8); opacity: 0; }
  }

  /* Codrops Animation 22: Zoom In */
  @keyframes ptZoomIn {
    from { transform: scale(0.75); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* Codrops Animation 23: Zoom Out */
  @keyframes ptZoomOut {
    from { transform: scale(1); opacity: 1; }
    to { transform: scale(0.75); opacity: 0; }
  }

  /* Codrops Animation 24: Scale Up */
  @keyframes ptScaleUp {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* Force solid opaque page during transitions to prevent transparent fade effect */
  ::view-transition-old(main-content),
  ::view-transition-new(main-content) {
    mix-blend-mode: normal !important;
    background-color: #F9F6EE !important;
    backface-visibility: hidden !important;
    overflow: hidden !important;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
  }

  /* Override OS-level reduced-motion to guarantee Codrops slide & zoom transitions play */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(main-content) {
      animation-duration: 0.6s !important;
      animation-timing-function: cubic-bezier(0.7, 0, 0.3, 1) !important;
    }
    ::view-transition-old(main-content),
    ::view-transition-new(main-content) {
      animation-duration: 0.6s !important;
      animation-timing-function: cubic-bezier(0.7, 0, 0.3, 1) !important;
      animation-fill-mode: both !important;
    }
  }
</style>
