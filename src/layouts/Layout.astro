---
import '../styles/design-tokens.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CreatorModal from '../components/CreatorModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "ZyoleKai • Gaming Talent Management & Brand Partnerships",
  description = "ZyoleKai represents 15 gaming creators with over 6.5M combined subscribers. We manage YouTube sponsorships, Minecraft SMP events, and brand partnerships.",
  image = "/brand/hero_banner.png"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="ZyoleKai, creator agency, gaming sponsorships, Minecraft SMP, YouTubers, streamer deals, brand integrations, esports network" />
    <meta name="author" content="ZyoleKai Organization" />

    <!-- Google Fonts: Asynchronous Non-Blocking Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    </noscript>

    <!-- Asset Preloads -->
    <link rel="preload" href="/brand/logo.webp" as="image" type="image/webp" />
    <link rel="preload" href="/brand/wordmark.webp" as="image" type="image/webp" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zyolekai.vercel.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://zyolekai.vercel.app" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Astro View Transitions for Client-side Navigation -->
    <ClientRouter />
  </head>
  <body>
    <!-- WCAG Priority 1: Skip to main content -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="ambient-mesh" aria-hidden="true"></div>
    
    <!-- Real Chroma-Keyed Organic Waves Extracted from Official Banner -->
    <div class="banner-waves-bg" aria-hidden="true">
      <img src="/brand/corner_wave_tl.webp" alt="" class="bg-wave-elem wave-tl" width="1743" height="969" />
      <img src="/brand/corner_wave_tr.webp" alt="" class="bg-wave-elem wave-tr" width="1438" height="177" />
      <img src="/brand/corner_wave_bl.webp" alt="" class="bg-wave-elem wave-bl" width="1541" height="168" />
      <img src="/brand/corner_wave_br.webp" alt="" class="bg-wave-elem wave-br" width="1636" height="864" />
    </div>

    <Navbar />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <CreatorModal />

    <script>
      // Paper Plane Flight & Animated Play/Pause Microinteractions
      function launchPaperPlane(x, y) {
        const plane = document.createElement('div');
        plane.className = 'paper-plane-flyer';
        plane.style.left = `${x}px`;
        plane.style.top = `${y}px`;
        plane.innerHTML = `
          <svg width="26" height="26" viewBox="0 0 24 24" fill="#00BF63" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
        `;
        document.body.appendChild(plane);
        plane.addEventListener('animationend', () => plane.remove());
      }

      function spawnEmojiPop(x, y, emoji1 = '▶️', emoji2 = '⏸️') {
        const pop = document.createElement('div');
        pop.className = 'btn-emoji-pop';
        pop.style.left = `${x}px`;
        pop.style.top = `${y}px`;
        pop.innerHTML = `<span>${emoji1}</span><span>✈️</span>`;
        document.body.appendChild(pop);
        setTimeout(() => {
          const first = pop.querySelector('span');
          if (first) first.textContent = emoji2;
        }, 180);
        pop.addEventListener('animationend', () => pop.remove());
      }

      // Attach to all interactive buttons
      document.addEventListener('click', (e) => {
        const target = e.target.closest('button, .btn, .pill-btn, .open-kit-btn, .yt-btn, .social-icon');
        if (!target) return;

        const rect = target.getBoundingClientRect();
        const clickX = e.clientX || (rect.left + rect.width / 2);
        const clickY = e.clientY || (rect.top + rect.height / 2);

        // Launch soaring paper plane
        launchPaperPlane(clickX, clickY);

        // Trigger tactile Play & Pause emoji pulse
        spawnEmojiPop(rect.left + rect.width / 2, rect.top);
      });
    </script>
  </body>
</html>
