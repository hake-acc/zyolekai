---
import Layout from '../layouts/Layout.astro';
import DealCalculator from '../components/DealCalculator.astro';

const sponsorshipTiers = [
  {
    id: "video",
    title: "Dedicated YouTube Video Integration",
    tagline: "High-impact creator endorsements & dedicated segments",
    desc: "Seamless 60–90 second dedicated integrations natively embedded into high-performing gaming videos. Includes tracked links, pinned comment discount codes, and guaranteed placement.",
    features: [
      "Native creator script integration (no robotic reads)",
      "Dedicated description links & pinned comment discounts",
      "Verified 30-day YouTube Studio analytics reporting",
      "Mandatory 48-hour preview review before public upload"
    ],
    badge: "CAMPAIGN-MANAGED"
  },
  {
    id: "smp",
    title: "Minecraft SMP & Tournament Series",
    tagline: "Live interactive multiplayer event sponsorship",
    desc: "Sponsor competitive creator SMP seasons, tournament livestreams, and server launches. Your brand is featured in-game with custom items, server broadcasts, and multi-creator streams.",
    features: [
      "In-game branded arenas, items, and custom lore",
      "Cross-promoted creator livestreams and vods",
      "Coordinated community recording sessions",
      "Exclusive Discord announcement & event role pings"
    ],
    badge: "EVENT-BASED"
  },
  {
    id: "hosting",
    title: "Server Hosting & Cloud Infrastructure",
    tagline: "Authentic infrastructure ambassadorships",
    desc: "Long-term partnerships for game server hosts, VPNs, cloud computing, and gaming hardware. Creators build tutorials, stress-test servers live, and offer trackable discount codes.",
    features: [
      "Dedicated server setup tutorials and gameplay showcases",
      "Long-term brand ambassadorships & affiliate revenue share",
      "Custom creator promo codes with tracked conversions",
      "Discord community endorsement & tech support showcase"
    ],
    badge: "AMBASSADORSHIPS"
  }
];
---

<Layout
  title="Brand Sponsorships & Campaign Placements | ZyoleKai Agency"
  description="Book dedicated gaming video integrations, Minecraft SMP tournament series, and server infrastructure partnerships across 15 verified creators."
>
  <section class="section sponsorships-page-section">
    <div class="container">
      <!-- Section Header -->
      <div class="spons-header">
        <h1 class="spons-title">
          Brand Sponsorships &amp; <span>Campaign Placements</span>
        </h1>

        <p class="spons-subtitle">
          Direct creator integrations across 15 verified gaming channels with 6.5M+ combined subscribers and over 1.1 Billion lifetime views. Transparent contracts, verified analytics, and guaranteed deliverables.
        </p>

        <div class="spons-stats-row">
          <div class="s-stat-chip">
            <span class="s-stat-num">5–7 Days</span>
            <span class="s-stat-lbl">Production Turnaround</span>
          </div>
          <div class="s-stat-chip">
            <span class="s-stat-num">48 Hours</span>
            <span class="s-stat-lbl">Preview Draft SLA</span>
          </div>
          <div class="s-stat-chip">
            <span class="s-stat-num">0%</span>
            <span class="s-stat-lbl">Creator Upfront Fees</span>
          </div>
        </div>
      </div>

      <!-- 3 Tier Cards -->
      <div class="tiers-grid">
        {sponsorshipTiers.map(tier => (
          <div class="tier-card glass-card">
            <div class="tier-top">
              <div class="tier-icon-wrap" aria-hidden="true">
                {tier.id === 'video' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tier-svg">
                    <rect x="2" y="4" width="20" height="16" rx="4" stroke="url(#emeraldGrad)"></rect>
                    <path d="M10 9.5l5 2.5-5 2.5v-5z" fill="url(#emeraldGrad)" stroke="none"></path>
                    <path d="M2 8h20" stroke="url(#emeraldGrad)"></path>
                  </svg>
                )}
                {tier.id === 'smp' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tier-svg">
                    <path d="M14.5 4l5.5 5.5-11 11H3.5v-5.5L14.5 4z" stroke="url(#emeraldGrad)"></path>
                    <path d="M9.5 4L4 9.5l11 11h5.5v-5.5L9.5 4z" stroke="url(#emeraldGrad)"></path>
                    <circle cx="12" cy="12" r="2.2" fill="url(#emeraldGrad)" stroke="none"></circle>
                  </svg>
                )}
                {tier.id === 'hosting' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tier-svg">
                    <rect x="3" y="4" width="18" height="6" rx="2" stroke="url(#emeraldGrad)"></rect>
                    <rect x="3" y="14" width="18" height="6" rx="2" stroke="url(#emeraldGrad)"></rect>
                    <circle cx="7" cy="7" r="1.2" fill="url(#emeraldGrad)" stroke="none"></circle>
                    <circle cx="7" cy="17" r="1.2" fill="url(#emeraldGrad)" stroke="none"></circle>
                    <path d="M14 7h3M14 17h3" stroke="url(#emeraldGrad)"></path>
                  </svg>
                )}
              </div>
              <span class="tier-badge">{tier.badge}</span>
            </div>

            <h3 class="tier-title">{tier.title}</h3>
            <p class="tier-tagline">{tier.tagline}</p>
            <p class="tier-desc">{tier.desc}</p>

            <ul class="tier-features">
              {tier.features.map(f => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-green)" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a href="https://discord.gg/zyolekai" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-pill tier-btn">
              <span>Book This Format</span>
            </a>
          </div>
        ))}
      </div>

      <!-- Campaign Reach Estimator -->
      <DealCalculator />
    </div>
  </section>
</Layout>

<style>
  .sponsorships-page-section {
    padding: 110px 0 80px 0;
  }

  .spons-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 56px;
  }


  .spons-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .spons-title span {
    color: var(--brand-green);
  }

  .spons-subtitle {
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .spons-stats-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .s-stat-chip {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(13, 28, 18, 0.1);
    border-radius: var(--radius-full);
    padding: 8px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 4px 12px rgba(13, 28, 18, 0.04);
  }

  .s-stat-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--brand-green);
  }

  .s-stat-lbl {
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 48px;
  }

  .tier-card {
    padding: 32px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid rgba(13, 28, 18, 0.1);
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(13, 28, 18, 0.04);
    transition: transform var(--duration-fast) var(--ease-spring),
                border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .tier-card:hover {
      transform: translateY(-4px);
      border-color: var(--brand-green);
      box-shadow: 0 16px 36px rgba(0, 191, 99, 0.15);
    }
    .tier-card:hover .tier-icon-wrap {
      transform: scale(1.08) rotate(3deg);
      border-color: var(--brand-green);
      background: rgba(0, 191, 99, 0.14);
    }
  }

  .tier-card:active {
    transform: scale(0.985);
  }

  .tier-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .tier-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(0, 191, 99, 0.08);
    border: 1.5px solid rgba(0, 191, 99, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-fast) var(--ease-spring),
                border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out);
  }

  .tier-svg {
    width: 26px;
    height: 26px;
  }

  .tier-badge {
    background: rgba(0, 191, 99, 0.1);
    color: #008744;
    border: 1px solid rgba(0, 191, 99, 0.25);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    letter-spacing: 0.06em;
  }

  .tier-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .tier-tagline {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--brand-green);
    margin-bottom: 12px;
  }

  .tier-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .tier-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
    padding: 0;
  }

  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .tier-features li svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .tier-btn {
    margin-top: auto;
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 960px) {
    .tiers-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .sponsorships-page-section {
      padding: 80px 0 60px 0;
    }
    .tier-card {
      padding: 24px 16px;
    }
  }
</style>
