---
import Layout from '../../layouts/Layout.astro';
import creatorsData from '../../data/creators.json';

export function getStaticPaths() {
  return creatorsData.map((creator) => ({
    params: { slug: creator.slug },
    props: { creator }
  }));
}

const { creator } = Astro.props;
const mediaKitImg = `/media-kits/${creator.slug}.webp`;
const mediaKitPng = `/media-kits/${creator.slug}.png`;
---

<Layout
  title={`${creator.name} • Official Influencer Media Kit | ZyoleKai`}
  description={`Official 2026 Influencer Media Kit for ${creator.name}. Review verified YouTube analytics: ${creator.subscribersShort} subscribers, ${creator.totalViewsShort} lifetime views, and ${creator.avgViewsShort} average views.`}
  image={mediaKitImg}
  transitionType="zoom"
>
  <section class="section kit-detail-section">
    <div class="container">
      <!-- Breadcrumb Navigation -->
      <div class="kit-nav-bar">
        <a href="/roster" class="back-link" data-transition="zoom-out">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Back to Talent Roster</span>
        </a>
      </div>

      <!-- Main Layout Grid -->
      <div class="kit-layout-grid">
        <!-- Left Column: The 1:1 High-Res Media Kit Showcase -->
        <div class="kit-showcase-column">
          <div class="kit-frame-wrap glass-card">
            <img
              src={mediaKitImg}
              alt={`Official 1:1 Media Kit for ${creator.name}`}
              class="kit-image"
              loading="eager"
            />
          </div>

          <div class="kit-quick-actions">
            <a
              href={mediaKitPng}
              download={`${creator.slug}-zyolekai-media-kit.png`}
              class="btn btn-secondary btn-pill action-btn"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download 1:1 PNG (723×1024)</span>
            </a>

            <a
              href="/ZyoleKai_Creator_Roster_Media_Kits_2026.pdf"
              download="ZyoleKai_Creator_Roster_Media_Kits_2026.pdf"
              class="btn btn-secondary btn-pill action-btn"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Download Full 18-Page PDF</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Live Creator Profile & Sponsorship Desk -->
        <div class="kit-info-column">
          <!-- Profile Header Card -->
          <div class="profile-card glass-card">
            <div class="creator-header-row">
              <img
                src={creator.avatar || creator.avatarUrl || `/avatars/${creator.slug}.webp`}
                alt={creator.name}
                class="creator-hero-avatar"
                width="84"
                height="84"
                onerror="this.src='/brand/logo.webp'"
              />
              <div class="creator-title-meta">
                <div class="name-badge-row">
                  <h1 class="creator-hero-name">{creator.name}</h1>
                  <svg class="verified-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" title="Verified Creator" aria-label="Verified Creator">
                    <path d="M12 2.2L19.5 5.5v5.8c0 5-3.3 9.4-7.5 10.5-4.2-1.1-7.5-5.5-7.5-10.5V5.5L12 2.2z" fill="url(#emeraldGrad)"></path>
                    <path d="M9 11.8l2.2 2.2 4.3-4.5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <p class="creator-hero-sub">Gaming &amp; Minecraft Content Creator</p>
                <a href={creator.youtubeUrl} target="_blank" rel="noopener noreferrer" class="hero-channel-link">
                  <span>{creator.youtubeUrl.replace('https://youtube.com/', '')}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Verified Metrics Grid -->
            <div class="metrics-summary-grid">
              <div class="summary-metric-box">
                <span class="s-metric-lbl">Subscribers</span>
                <span class="s-metric-val">{creator.subscribersShort}</span>
                <span class="s-metric-sub">{creator.videoCount || '50+ videos'}</span>
              </div>
              <div class="summary-metric-box">
                <span class="s-metric-lbl">Total Views</span>
                <span class="s-metric-val">{creator.totalViewsShort}</span>
                <span class="s-metric-sub">Lifetime reach</span>
              </div>
              <div class="summary-metric-box">
                <span class="s-metric-lbl">Avg. Views</span>
                <span class="s-metric-val">{creator.avgViewsShort}</span>
                <span class="s-metric-sub">Per integration</span>
              </div>
              <div class="summary-metric-box">
                <span class="s-metric-lbl">Median Views</span>
                <span class="s-metric-val">{creator.medianViewsShort}</span>
                <span class="s-metric-sub">Baseline retention</span>
              </div>
              <div class="summary-metric-box">
                <span class="s-metric-lbl">Engagement</span>
                <span class="s-metric-val">{creator.engagementRate}</span>
                <span class="s-metric-sub">Likes &amp; comments</span>
              </div>
              <div class="summary-metric-box">
                <span class="s-metric-lbl">Typical RPM</span>
                <span class="s-metric-val text-brand">{creator.rpm}</span>
                <span class="s-metric-sub">Industry baseline</span>
              </div>
            </div>
          </div>

          <!-- Booking & Sponsorship CTA Card -->
          <div class="booking-card glass-card">
            <h3 class="booking-title">Book a Campaign with {creator.name}</h3>
            <p class="booking-desc">
              Looking for a dedicated in-video segment, tournament livestream placement, or long-term brand ambassador partnership? Our agency handles all communications and deliverable review.
            </p>

            <div class="sla-bullets">
              <div class="sla-item">
                <span class="sla-check">✓</span>
                <span><strong>5–7 Day SLA:</strong> Fast production turnaround from brief to publish</span>
              </div>
              <div class="sla-item">
                <span class="sla-check">✓</span>
                <span><strong>48-Hour Preview:</strong> Video draft provided for brand sign-off before upload</span>
              </div>
              <div class="sla-item">
                <span class="sla-check">✓</span>
                <span><strong>Verified Reporting:</strong> 30-day YouTube Studio analytics &amp; click tracking</span>
              </div>
            </div>

            <div class="booking-actions">
              <a
                href="https://discord.gg/zyolekai"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-pill"
                style="width: 100%; justify-content: center;"
              >
                <span>Discuss Campaign on Discord</span>
              </a>

              <a
                href={creator.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary btn-pill"
                style="width: 100%; justify-content: center;"
              >
                <span>Visit YouTube Channel ↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .kit-detail-section {
    padding: 100px 0 80px 0;
  }

  .kit-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-spring);
  }

  .back-link:hover {
    color: var(--brand-green);
    transform: translateX(-4px);
  }


  .kit-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 40px;
    align-items: flex-start;
  }

  .kit-showcase-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .kit-frame-wrap {
    padding: 12px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid rgba(13, 28, 18, 0.1);
    box-shadow: 0 20px 50px rgba(13, 28, 18, 0.08);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .kit-image {
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(13, 28, 18, 0.06);
  }

  .kit-quick-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
  }

  .kit-info-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .profile-card {
    padding: 32px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid rgba(13, 28, 18, 0.1);
    box-shadow: 0 12px 36px rgba(13, 28, 18, 0.05);
  }

  .creator-header-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1.5px solid rgba(13, 28, 18, 0.08);
  }

  .creator-hero-avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 3px solid var(--brand-green);
    box-shadow: 0 0 16px rgba(0, 191, 99, 0.25);
    object-fit: cover;
  }

  .name-badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .creator-hero-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
  }

  .creator-hero-sub {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .hero-channel-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-green);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    margin-top: 6px;
  }

  .hero-channel-link:hover {
    text-decoration: underline;
  }

  .metrics-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 24px;
  }

  .summary-metric-box {
    background: #FAF7EE;
    border: 1px solid rgba(13, 28, 18, 0.08);
    border-radius: var(--radius-md);
    padding: 14px;
    text-align: center;
  }

  .s-metric-lbl {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .s-metric-val {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 4px 0 2px 0;
  }

  .s-metric-sub {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  .booking-card {
    padding: 32px;
    border-radius: var(--radius-lg);
    background: #FAF7EE;
    border: 1.5px solid rgba(0, 191, 99, 0.3);
    box-shadow: 0 16px 40px rgba(13, 28, 18, 0.06);
  }

  .booking-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .booking-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .sla-bullets {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .sla-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .sla-check {
    color: var(--brand-green);
    font-weight: 800;
  }

  .booking-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 900px) {
    .kit-layout-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .metrics-summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .kit-detail-section {
      padding: 80px 0 60px 0;
    }
    .profile-card,
    .booking-card {
      padding: 24px 16px;
    }
  }
</style>
